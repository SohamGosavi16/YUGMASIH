        "drone_freqs": [110.0, 164.81, 220.0, 329.63]
    },
    {
        "id": "neermahal_palace",
        "whom_made": "King Bir Bikram Kishore Manikya Bahadur (Manikya Dynasty)",
        "picked_from": "Melaghar, Tripura (Rudrasagar Lake Island)",
        "title": "Neermahal Water Palace",
        "hindi": "নীরমহল",
        "state": "Tripura",
        "region": "East",
        "era": "1930–1938 CE",
        "file": "neermahal-vr.html",
        "alias_file": "neermahal_3d.html",
        "thumb": "https://upload.wikimedia.org/wikipedia/commons/thumb/3/30/Neermahal_Tripura.jpg/640px-Neermahal_Tripura.jpg",
        "badge": "Royal Lake Palace of Rudrasagar",
        "desc": "Floating jewel of the Manikya kings built in the center of Rudrasagar Lake, fusing Hindu and Mughal pavilions with motorboat landing docks and royal water gardens.",
        "drone_freqs": [130.81, 196.00, 261.63, 392.00]
    }
]

# ── 3. CODE GENERATOR FOR STANDALONE SKETCHFAB VIEWERS ─────────────────────
def generate_standalone_html(m):
    views_buttons = ""
    views_js = ""
    for v in m["views"]:
        views_buttons += f'''      <button class="dock-btn{" active" if v["id"] == m["views"][0]["id"] else ""}" id="{v["id"]}" title="{v["toast"]}">
        <i class="fa-solid {v["icon"]}"></i>
        <span>{v["label"]}</span>
      </button>\n'''

        if v["id"] == "view-reset":
            views_js += f'''      var btn_{v["id"].replace("-", "_")} = document.getElementById('{v["id"]}');
      if (btn_{v["id"].replace("-", "_")}) {{
        btn_{v["id"].replace("-", "_")}.addEventListener('click', function () {{
          setDockActive(btn_{v["id"].replace("-", "_")});
          if (sketchfabApi && sketchfabApi.recenterCamera) {{
            sketchfabApi.recenterCamera(function () {{}});
          }} else {{
            iframe.src = iframe.src;
          }}
          showToast('{v["toast"]}');
        }});
      }}\n'''
        else:
            pos = v.get("pos", [0, -100, 40])
            tgt = v.get("target", [0, 0, 15])
            views_js += f'''      var btn_{v["id"].replace("-", "_")} = document.getElementById('{v["id"]}');
      if (btn_{v["id"].replace("-", "_")}) {{
        btn_{v["id"].replace("-", "_")}.addEventListener('click', function () {{
          setDockActive(btn_{v["id"].replace("-", "_")});
          if (sketchfabApi && sketchfabApi.setCameraLookAt) {{
            sketchfabApi.setCameraLookAt({pos}, {tgt}, 1.8, function () {{}});
          }}
          showToast('{v["toast"]}');
        }});
      }}\n'''

    sections_html = ""
    for s in m["info_sections"]:
        sections_html += f'''      <div class="modal-section">
        <h3><i class="fa-solid {s["icon"]}"></i> {s["title"]}</h3>
        <p>{s["text"]}</p>
      </div>\n'''

    drone_array = ", ".join(str(f) for f in m["drone_freqs"])

    return f'''<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>{m["title"]} — Realistic 3D Model | YUGMA Indian Heritage</title>
  <meta name="description" content="{m["desc"]}">

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700;800&family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,400&family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

  <!-- Sketchfab Viewer API -->
  <script type="text/javascript" src="https://static.sketchfab.com/api/sketchfab-viewer-1.12.1.js"></script>

  <style>
    :root {{
      --bg-dark: #07090e;
      --gold: #dfa753;
      --gold-bright: #ffd56b;
      --gold-glow: rgba(223, 167, 83, 0.4);
      --marble-white: #f5f1e8;
      --glass-bg: rgba(9, 13, 20, 0.78);
      --glass-border: rgba(223, 167, 83, 0.32);
      --glass-card: rgba(14, 20, 32, 0.88);
      --ease: cubic-bezier(0.16, 1, 0.3, 1);
    }}

    * {{
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      user-select: none;
      -webkit-user-select: none;
    }}

    html, body {{
      width: 100%;
      height: 100%;
      overflow: hidden;
      background: var(--bg-dark);
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
      color: #f8fafc;
    }}

    /* 3D Model Stage Container */
    #viewer-stage {{
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      z-index: 1;
      background: radial-gradient(circle at 50% 40%, #151d2a 0%, #080a0f 85%, #040507 100%);
      transition: filter 0.8s ease;
    }}

    #sketchfab-frame {{
      position: absolute;
      top: -54px;
      left: 0;
      width: 100%;
      height: calc(100% + 108px);
      border: none;
      display: block;
    }}

    /* Corner Shields to eliminate owner avatar/name in top-left and Sketchfab logo in bottom-left */
    .brand-shield-top-left {{
      position: fixed;
      top: 0;
      left: 0;
      width: 260px;
      height: 62px;
      z-index: 11;
      pointer-events: none;
      background: linear-gradient(135deg, rgba(7, 9, 14, 0.96) 0%, rgba(7, 9, 14, 0.72) 45%, transparent 100%);
    }}

    .brand-shield-bottom-left {{
      position: fixed;
      bottom: 0;
      left: 0;
      min-width: 210px;
      height: 52px;
      z-index: 12;
      pointer-events: auto;
      display: flex;
      align-items: center;
      padding-left: 20px;
      padding-bottom: 4px;
      background: linear-gradient(45deg, rgba(7, 9, 14, 0.96) 0%, rgba(7, 9, 14, 0.75) 50%, transparent 100%);
      border-top-right-radius: 12px;
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
    }}
    .brand-shield-badge {{
      display: inline-flex;
      align-items: center;
      gap: 7px;
      font-family: 'Cinzel', serif;
      font-size: 10px;
      letter-spacing: 1.2px;
      font-weight: 700;
      color: var(--gold-bright, #ffd56b);
      text-transform: uppercase;
      text-shadow: 0 1px 4px rgba(0,0,0,0.8);
      user-select: none;
    }}
    .brand-shield-badge i {{
      color: var(--gold, #dfa753);
      font-size: 11px;
    }}

    /* Atmosphere Lighting Overlay Filters */
    .atmos-dawn {{
      filter: sepia(0.25) saturate(1.3) hue-rotate(-12deg) brightness(1.05) contrast(1.04);
    }}
    .atmos-noon {{
      filter: contrast(1.06) brightness(1.08) saturate(1.02);
    }}
    .atmos-sunset {{
      filter: sepia(0.55) saturate(1.6) hue-rotate(-22deg) contrast(1.12) brightness(0.98);
    }}
    .atmos-moonlight {{
      filter: brightness(0.85) contrast(1.2) hue-rotate(185deg) saturate(0.65);
    }}

    /* Ambient Glow behind frame */
    #stage-vignette {{
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 2;
      box-shadow: inset 0 0 100px rgba(0,0,0,0.65), inset 0 0 200px rgba(4,6,10,0.85);
    }}

    /* Top Navigation Bar */
    .top-nav {{
      position: fixed;
      top: 18px;
      left: 20px;
      right: 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      z-index: 15;
      pointer-events: none;
    }}

    .nav-left, .nav-right {{
      display: flex;
      align-items: center;
      gap: 10px;
      pointer-events: auto;
    }}

    .badge-btn {{
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 16px;
      background: var(--glass-bg);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border: 1px solid var(--glass-border);
      border-radius: 30px;
      color: var(--marble-white);
      text-decoration: none;
      font-size: 11.5px;
      font-weight: 600;
      letter-spacing: 0.8px;
      transition: all 0.25s var(--ease);
      box-shadow: 0 8px 24px rgba(0,0,0,0.4);
      cursor: pointer;
    }}

    .badge-btn:hover {{
      background: rgba(223, 167, 83, 0.2);
      border-color: var(--gold-bright);
      color: var(--gold-bright);
      transform: translateY(-2px);
      box-shadow: 0 12px 28px rgba(223, 167, 83, 0.25);
    }}

    .badge-btn i {{
      color: var(--gold);
      font-size: 13px;
    }}

    .portal-tag {{
      display: flex;
      flex-direction: column;
      padding: 7px 14px;
      background: rgba(10, 14, 22, 0.7);
      backdrop-filter: blur(10px);
      border: 1px solid rgba(223, 167, 83, 0.2);
      border-radius: 8px;
    }}
    .portal-tag span:first-child {{
      font-size: 9px;
      font-weight: 700;
      letter-spacing: 2px;
      color: var(--gold);
      text-transform: uppercase;
      font-family: 'Space Grotesk', sans-serif;
    }}
    .portal-tag span:last-child {{
      font-size: 11px;
      color: #94a3b8;
      font-weight: 500;
    }}

    /* Main Title Card */
    #title-card {{
      position: fixed;
      top: 80px;
      left: 20px;
      max-width: 380px;
      background: var(--glass-card);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      border: 1px solid var(--glass-border);
      border-radius: 18px;
      padding: 22px 24px;
      color: var(--marble-white);
      z-index: 12;
      box-shadow: 0 16px 40px rgba(0,0,0,0.6), 0 0 25px rgba(223, 167, 83, 0.12);
      transition: all 0.35s var(--ease);
    }}

    #title-card.collapsed {{
      transform: translateY(-10px);
      padding: 12px 18px;
    }}
    #title-card.collapsed .body-content {{
      display: none;
    }}

    .card-header {{
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 6px;
    }}

    .monument-subtitle {{
      font-family: 'Space Grotesk', sans-serif;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 2.5px;
      text-transform: uppercase;
      color: var(--gold);
      display: block;
      margin-bottom: 4px;
    }}

    h1.monument-title {{
      font-family: 'Cinzel', serif;
      font-weight: 700;
      font-size: 26px;
      line-height: 1.15;
      letter-spacing: 0.5px;
      background: linear-gradient(135deg, #ffffff 0%, #fff1d0 50%, #dfa753 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }}

    .hindi-title {{
      font-family: 'Cormorant Garamond', serif;
      font-size: 17px;
      font-weight: 600;
      color: rgba(223, 167, 83, 0.85);
      margin-left: 6px;
      -webkit-text-fill-color: initial;
    }}

    .btn-collapse {{
      background: rgba(255,255,255,0.06);
      border: 1px solid rgba(223, 167, 83, 0.25);
      color: var(--gold);
      border-radius: 50%;
      width: 26px;
      height: 26px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      font-size: 12px;
      transition: all 0.2s;
    }}
    .btn-collapse:hover {{
      background: var(--gold);
      color: #04070a;
    }}

    .monument-desc {{
      font-size: 12.8px;
      line-height: 1.6;
      color: #cbd5e1;
      margin-top: 10px;
    }}

    /* Model Specs Badges */
    .specs-grid {{
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 8px;
      margin-top: 14px;
      padding-top: 12px;
      border-top: 1px solid rgba(223, 167, 83, 0.18);
    }}

    .spec-item {{
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(255,255,255,0.06);
      border-radius: 8px;
      padding: 6px 8px;
      text-align: center;
    }}
    .spec-val {{
      font-family: 'Space Grotesk', sans-serif;
      font-size: 12.5px;
      font-weight: 700;
      color: var(--gold-bright);
      display: block;
    }}
    .spec-lbl {{
      font-size: 9px;
      letter-spacing: 0.8px;
      text-transform: uppercase;
      color: #94a3b8;
    }}

    .heritage-provenance {{
      margin-top: 14px;
      padding: 10px 12px;
      background: rgba(223, 167, 83, 0.08);
      border: 1px solid rgba(223, 167, 83, 0.22);
      border-radius: 8px;
      display: flex;
      flex-direction: column;
      gap: 7px;
    }}
    .prov-row {{
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 10px;
      font-size: 11px;
    }}
    .prov-badge {{
      display: inline-flex;
      align-items: center;
      gap: 5px;
      font-size: 9px;
      letter-spacing: 0.8px;
      text-transform: uppercase;
      color: #94a3b8;
      font-weight: 600;
      white-space: nowrap;
    }}
    .prov-badge i {{
      color: var(--gold);
      font-size: 10px;
    }}
    .prov-text {{
      color: #f1f5f9;
      text-align: right;
      font-weight: 500;
      font-size: 11.5px;
    }}
    .prov-text strong {{
      color: var(--gold-bright);
      font-weight: 600;
    }}

    /* Bottom Floating Dock */
    #dock-container {{
      position: fixed;
      bottom: 24px;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
      z-index: 15;
      max-width: 96vw;
    }}

    /* Atmosphere Selector Pill */
    .atmos-bar {{
      display: flex;
      align-items: center;
      background: rgba(12, 17, 27, 0.85);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border: 1px solid rgba(223, 167, 83, 0.3);
      border-radius: 30px;
      padding: 4px 6px;
      gap: 4px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.5);
    }}

    .atmos-btn {{
      padding: 6px 14px;
      border: none;
      background: transparent;
      color: #94a3b8;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.6px;
      border-radius: 20px;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: all 0.2s var(--ease);
    }}
    .atmos-btn:hover {{
      color: var(--marble-white);
      background: rgba(255,255,255,0.06);
    }}
    .atmos-btn.active {{
      background: linear-gradient(135deg, #dfa753 0%, #c98845 100%);
      color: #06090f;
      font-weight: 700;
      box-shadow: 0 4px 14px rgba(223, 167, 83, 0.4);
    }}

    /* Viewport Navigation Dock */
    .view-dock {{
      display: flex;
      align-items: center;
      gap: 8px;
      background: var(--glass-card);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      border: 1px solid var(--glass-border);
      border-radius: 18px;
      padding: 8px 12px;
      box-shadow: 0 12px 36px rgba(0,0,0,0.55), 0 0 20px rgba(223, 167, 83, 0.15);
      flex-wrap: wrap;
      justify-content: center;
    }}

    .dock-btn {{
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 4px;
      width: 72px;
      height: 58px;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.06);
      border-radius: 12px;
      color: #cbd5e1;
      cursor: pointer;
      transition: all 0.2s var(--ease);
      font-family: inherit;
    }}

    .dock-btn i {{
      font-size: 16px;
      color: var(--gold);
      transition: transform 0.2s;
    }}

    .dock-btn span {{
      font-size: 9px;
      font-weight: 600;
      letter-spacing: 0.4px;
      text-transform: uppercase;
      text-align: center;
      line-height: 1.1;
    }}

    .dock-btn:hover {{
      background: rgba(223, 167, 83, 0.15);
      border-color: var(--gold);
      color: var(--gold-bright);
      transform: translateY(-2px);
    }}
    .dock-btn:hover i {{
      transform: scale(1.15);
    }}

    .dock-btn.active {{
      background: linear-gradient(135deg, #dfa753 0%, #ffd56b 100%);
      color: #06090f;
      border-color: #ffd56b;
      font-weight: 700;
      box-shadow: 0 6px 18px rgba(223, 167, 83, 0.4);
    }}
    .dock-btn.active i {{
      color: #06090f;
    }}

    /* Interaction Hint */
    #orbit-hint {{
      position: fixed;
      bottom: 124px;
      left: 50%;
      transform: translateX(-50%);
      font-size: 11.5px;
      letter-spacing: 0.8px;
      color: rgba(245, 241, 232, 0.5);
      z-index: 10;
      pointer-events: none;
      display: flex;
      align-items: center;
      gap: 8px;
      background: rgba(9, 13, 20, 0.6);
      padding: 5px 14px;
      border-radius: 20px;
      backdrop-filter: blur(8px);
      transition: opacity 0.6s;
    }}

    /* Info Modal Dialog */
    #info-modal {{
      position: fixed;
      inset: 0;
      background: rgba(4, 7, 12, 0.75);
      backdrop-filter: blur(10px);
      z-index: 100;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }}
    #info-modal.active {{
      display: flex;
    }}

    .modal-card {{
      background: #0d121c;
      border: 1px solid var(--glass-border);
      border-radius: 20px;
      max-width: 620px;
      width: 100%;
      max-height: 85vh;
      overflow-y: auto;
      padding: 30px;
      position: relative;
      box-shadow: 0 25px 60px rgba(0,0,0,0.8), 0 0 35px rgba(223, 167, 83, 0.2);
    }}

    .modal-close {{
      position: absolute;
      top: 20px;
      right: 20px;
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: rgba(255,255,255,0.06);
      border: 1px solid rgba(223, 167, 83, 0.3);
      color: var(--gold);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      font-size: 14px;
      transition: all 0.2s;
    }}
    .modal-close:hover {{
      background: var(--gold);
      color: #04070a;
    }}

    .modal-title {{
      font-family: 'Cinzel', serif;
      font-size: 24px;
      color: var(--gold-bright);
      margin-bottom: 6px;
    }}

    .modal-subtitle {{
      font-size: 11px;
      letter-spacing: 2px;
      color: #94a3b8;
      text-transform: uppercase;
      margin-bottom: 20px;
    }}

    .modal-section {{
      margin-bottom: 18px;
    }}
    .modal-section h3 {{
      font-size: 14px;
      color: var(--gold);
      margin-bottom: 6px;
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 8px;
    }}
    .modal-section p {{
      font-size: 13px;
      line-height: 1.65;
      color: #cbd5e1;
    }}

    /* Toast Notifications */
    #toast {{
      position: fixed;
      top: 80px;
      left: 50%;
      transform: translateX(-50%);
      background: var(--glass-card);
      border: 1px solid var(--gold);
      border-radius: 30px;
      padding: 10px 22px;
      color: var(--gold-bright);
      font-size: 12.5px;
      font-weight: 600;
      box-shadow: 0 10px 30px rgba(0,0,0,0.6);
      z-index: 50;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s, transform 0.3s;
    }}
    #toast.show {{
      opacity: 1;
      transform: translateX(-50%) translateY(5px);
    }}

    @media (max-width: 768px) {{
      #title-card {{
        top: 72px;
        left: 12px;
        right: 12px;
        max-width: none;
        padding: 16px 18px;
      }}
      h1.monument-title {{
        font-size: 20px;
      }}
      .dock-btn {{
        width: 60px;
        height: 52px;
      }}
      .dock-btn span {{
        font-size: 8px;
      }}
      .atmos-btn {{
        padding: 5px 10px;
        font-size: 10px;
      }}
      .portal-tag {{
        display: none;
      }}
    }}
  </style>
</head>
<body>

  <!-- 3D Model Stage Container -->
  <div id="viewer-stage" class="atmos-noon">
    <!-- Direct Sketchfab Responsive Embedded 3D Viewer with Model UID {m["uid"]} -->
    <iframe
      id="sketchfab-frame"
      title="{m["title"]} - 3D Heritage Model"
      src="https://sketchfab.com/models/{m["uid"]}/embed?autostart=1&internal=1&tracking=0&ui_ar=1&ui_infos=0&ui_snapshots=1&ui_stop=0&ui_theatre=1&ui_watermark=0&ui_theme=dark&camera=0&preload=1"
      allow="autoplay; fullscreen; xr-spatial-tracking; web-share"
      xr-spatial-tracking="true"
      execution-while-out-of-viewport="true"
      execution-while-not-rendered="true"
      web-share="true"
      allowfullscreen
      mozallowfullscreen="true"
      webkitallowfullscreen="true">
    </iframe>
  </div>

  <div id="stage-vignette"></div>

  <!-- Corner Shields removing owner logo in top-left & Sketchfab watermark in bottom-left -->
  <div class="brand-shield-top-left" aria-hidden="true"></div>
  <div class="brand-shield-bottom-left" aria-hidden="true">
    <div class="brand-shield-badge">
      <i class="fa-solid fa-cube"></i>
      <span>HERITAGE 3D</span>
    </div>
  </div>

  <!-- Top Navigation Header -->
  <header class="top-nav">
    <div class="nav-left">
      <a href="index.html" class="badge-btn" title="Return to India 3D Globe">
        <i class="fa-solid fa-arrow-left"></i>
        <span>3D GLOBE</span>
      </a>
      <div class="portal-tag">
        <span>{m["state"]}</span>
        <span>{m["location"]}</span>
      </div>
    </div>

    <div class="nav-right">
      <a href="all_3d_models.html" class="badge-btn" style="background: rgba(223, 167, 83, 0.2); border-color: #dfa753; color: #ffd56b;" title="View all 3D models in Vault">
        <i class="fa-solid fa-layer-group"></i>
        <span>ALL 3D MODELS</span>
      </a>

      <button class="badge-btn" id="btn-audio" title="Toggle Heritage Ambient Soundscape">
        <i class="fa-solid fa-volume-high" id="audio-icon"></i>
        <span id="audio-text">AMBIENCE</span>
      </button>

      <button class="badge-btn" id="btn-info" title="{m["title"]} Architectural Details">
        <i class="fa-solid fa-circle-info"></i>
        <span>DETAILS</span>
      </button>

      <button class="badge-btn" id="btn-fullscreen" title="Toggle Fullscreen Mode">
        <i class="fa-solid fa-expand"></i>
      </button>
    </div>
  </header>

  <!-- Left Info Card -->
  <aside id="title-card">
    <div class="card-header">
      <div>
        <span class="monument-subtitle">{m["subtitle"]}</span>
        <h1 class="monument-title">{m["title"]} <span class="hindi-title">({m["hindi_title"]})</span></h1>
      </div>
      <button class="btn-collapse" id="btn-collapse" aria-label="Toggle details panel">
        <i class="fa-solid fa-chevron-up"></i>
      </button>
    </div>

    <div class="body-content">
      <p class="monument-desc">
        {m["desc"]}
      </p>

      <div class="specs-grid">
        <div class="spec-item">
          <span class="spec-val">{m["spec_polys"]}</span>
          <span class="spec-lbl">Architecture</span>
        </div>
        <div class="spec-item">
          <span class="spec-val">{m["spec_verts"]}</span>
          <span class="spec-lbl">Carvings</span>
        </div>
        <div class="spec-item">
          <span class="spec-val">{m["spec_tex"]}</span>
          <span class="spec-lbl">Textures</span>
        </div>
      </div>

      <div class="heritage-provenance">
        <div class="prov-row">
          <span class="prov-badge"><i class="fa-solid fa-monument"></i> BUILT FOR</span>
          <span class="prov-text"><strong>{m["whom_made"]}</strong></span>
        </div>
        <div class="prov-row">
          <span class="prov-badge"><i class="fa-solid fa-location-dot"></i> PICKED FROM</span>
          <span class="prov-text"><strong>{m["picked_from"]}</strong></span>
        </div>
      </div>
    </div>
  </aside>

  <!-- Interaction Hint -->
  <div id="orbit-hint">
    <i class="fa-solid fa-arrows-spin"></i>
    <span>Left Click / Touch to Orbit · Right Click / Two Fingers to Pan · Scroll to Zoom</span>
  </div>

  <!-- Bottom Interactive Floating Dock -->
  <div id="dock-container">
    <!-- Atmosphere Lighting Filter Bar -->
    <div class="atmos-bar">
      <button class="atmos-btn" data-atmos="atmos-dawn">
        <i class="fa-regular fa-sun"></i> Dawn Blush
      </button>
      <button class="atmos-btn active" data-atmos="atmos-noon">
        <i class="fa-solid fa-sun"></i> White Noon
      </button>
      <button class="atmos-btn" data-atmos="atmos-sunset">
        <i class="fa-solid fa-cloud-sun"></i> Sunset Gold
      </button>
      <button class="atmos-btn" data-atmos="atmos-moonlight">
        <i class="fa-solid fa-moon"></i> Moonlight
      </button>
    </div>

    <!-- View & Guided Angles Dock -->
    <div class="view-dock">
{views_buttons}    </div>
  </div>

  <!-- Detailed Architectural Info Modal -->
  <div id="info-modal">
    <div class="modal-card">
      <button class="modal-close" id="modal-close"><i class="fa-solid fa-xmark"></i></button>
      <h2 class="modal-title">{m["title"]} Heritage</h2>
      <div class="modal-subtitle">{m["subtitle"]}</div>

{sections_html}
      <div class="modal-section">
        <h3><i class="fa-solid fa-landmark-dome"></i> Monument Provenance & Heritage</h3>
        <p>This interactive 3D digital model showcases the living architectural heritage of <strong>{m["title"]}</strong>, located in <strong>{m["picked_from"]}</strong> and built for <strong>{m["whom_made"]}</strong>. Curated for interactive preservation and cultural learning.</p>
      </div>
    </div>
  </div>

  <!-- Dynamic Toast Message -->
  <div id="toast">Perspective Updated</div>

  <script>
    (function () {{
      "use strict";

      var stage = document.getElementById('viewer-stage');
      var iframe = document.getElementById('sketchfab-frame');
      var toast = document.getElementById('toast');
      var titleCard = document.getElementById('title-card');
      var collapseBtn = document.getElementById('btn-collapse');
      var infoModal = document.getElementById('info-modal');
      var infoBtn = document.getElementById('btn-info');
      var modalClose = document.getElementById('modal-close');
      var fullscreenBtn = document.getElementById('btn-fullscreen');
      var audioBtn = document.getElementById('btn-audio');
      var audioIcon = document.getElementById('audio-icon');
      var audioText = document.getElementById('audio-text');
      var sketchfabApi = null;

      function showToast(msg) {{
        toast.textContent = msg;
        toast.classList.add('show');
        clearTimeout(toast._timer);
        toast._timer = setTimeout(function () {{
          toast.classList.remove('show');
        }}, 2200);
      }}

      // Title Card Collapse Toggle
      collapseBtn.addEventListener('click', function () {{
        titleCard.classList.toggle('collapsed');
        var isCollapsed = titleCard.classList.contains('collapsed');
        collapseBtn.innerHTML = isCollapsed ? '<i class="fa-solid fa-chevron-down"></i>' : '<i class="fa-solid fa-chevron-up"></i>';
      }});

      // Info Modal Open / Close
      infoBtn.addEventListener('click', function () {{
        infoModal.classList.add('active');
      }});
      modalClose.addEventListener('click', function () {{
        infoModal.classList.remove('active');
      }});
      infoModal.addEventListener('click', function (e) {{
        if (e.target === infoModal) infoModal.classList.remove('active');
      }});

      // Atmosphere Lighting Filter Switching
      var atmosBtns = document.querySelectorAll('.atmos-btn');
      atmosBtns.forEach(function (btn) {{
        btn.addEventListener('click', function () {{
          atmosBtns.forEach(function (b) {{ b.classList.remove('active'); }});
          btn.classList.add('active');
          var chosen = btn.getAttribute('data-atmos');
          stage.className = chosen;
          showToast(btn.textContent.trim() + " atmosphere activated");
        }});
      }});

      // Fullscreen Toggle
      fullscreenBtn.addEventListener('click', function () {{
        if (!document.fullscreenElement) {{
          document.documentElement.requestFullscreen().catch(function () {{}});
          fullscreenBtn.innerHTML = '<i class="fa-solid fa-compress"></i>';
          showToast('Entered Fullscreen');
        }} else {{
          document.exitFullscreen().catch(function () {{}});
          fullscreenBtn.innerHTML = '<i class="fa-solid fa-expand"></i>';
          showToast('Exited Fullscreen');
        }}
      }});

      // Procedural Web Audio Ambient Soundscape
      var audioCtx = null;
      var isAudioPlaying = false;
      var ambientNodes = [];

      function startAmbience() {{
        try {{
          var AudioContext = window.AudioContext || window.webkitAudioContext;
          if (!audioCtx) audioCtx = new AudioContext();
          if (audioCtx.state === 'suspended') audioCtx.resume();

          // Master Gain
          var masterGain = audioCtx.createGain();
          masterGain.gain.setValueAtTime(0.01, audioCtx.currentTime);
          masterGain.gain.exponentialRampToValueAtTime(0.18, audioCtx.currentTime + 2.5);
          masterGain.connect(audioCtx.destination);
          ambientNodes.push(masterGain);

          // Warm Harmonic Drone
          var baseFreqs = [{drone_array}];
          baseFreqs.forEach(function (f, idx) {{
            var osc = audioCtx.createOscillator();
            var oscGain = audioCtx.createGain();
            osc.type = idx % 2 === 0 ? 'sine' : 'triangle';
            osc.frequency.setValueAtTime(f, audioCtx.currentTime);

            // Gentle LFO
            var lfo = audioCtx.createOscillator();
            lfo.frequency.setValueAtTime(0.2 + idx * 0.1, audioCtx.currentTime);
            var lfoGain = audioCtx.createGain();
            lfoGain.gain.setValueAtTime(1.5, audioCtx.currentTime);
            lfo.connect(lfoGain);
            lfoGain.connect(osc.frequency);
            lfo.start();

            oscGain.gain.setValueAtTime(0.04 / (idx + 1), audioCtx.currentTime);
            osc.connect(oscGain);
            oscGain.connect(masterGain);
            osc.start();
            ambientNodes.push(osc, lfo);
          }});

          // Shimmer Air Filter
          var bufferSize = audioCtx.sampleRate * 2;
          var noiseBuffer = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate);
          var output = noiseBuffer.getChannelData(0);
          for (var i = 0; i < bufferSize; i++) {{
            output[i] = Math.random() * 2 - 1;
          }}
          var whiteNoise = audioCtx.createBufferSource();
          whiteNoise.buffer = noiseBuffer;
          whiteNoise.loop = true;

          var biquad = audioCtx.createBiquadFilter();
          biquad.type = 'bandpass';
          biquad.frequency.setValueAtTime(1100, audioCtx.currentTime);
          biquad.Q.setValueAtTime(1.4, audioCtx.currentTime);

          var noiseGain = audioCtx.createGain();
          noiseGain.gain.setValueAtTime(0.02, audioCtx.currentTime);

          whiteNoise.connect(biquad);
          biquad.connect(noiseGain);
          noiseGain.connect(masterGain);
          whiteNoise.start();
          ambientNodes.push(whiteNoise);

          isAudioPlaying = true;
          audioIcon.className = 'fa-solid fa-volume-high';
          audioText.textContent = 'SOUND ON';
          audioBtn.style.borderColor = 'var(--gold-bright)';
          audioBtn.style.color = 'var(--gold-bright)';
          showToast('{m["title"]} Soundscape Playing');
        }} catch (e) {{
          console.warn('Audio not supported or blocked:', e);
        }}
      }}

      function stopAmbience() {{
        if (ambientNodes.length) {{
          ambientNodes.forEach(function (n) {{
            try {{
              if (n.stop) n.stop();
              if (n.disconnect) n.disconnect();
            }} catch (err) {{}}
          }});
          ambientNodes = [];
        }}
        isAudioPlaying = false;
        audioIcon.className = 'fa-solid fa-volume-xmark';
        audioText.textContent = 'MUTED';
        audioBtn.style.borderColor = 'var(--glass-border)';
        audioBtn.style.color = 'var(--marble-white)';
        showToast('Ambience Muted');
      }}

      audioBtn.addEventListener('click', function () {{
        if (!isAudioPlaying) {{
          startAmbience();
        }} else {{
          stopAmbience();
        }}
      }});

      // Initialize Sketchfab Client API
      if (window.Sketchfab) {{
        try {{
          var client = new window.Sketchfab(iframe);
          client.init('{m["uid"]}', {{
            success: function onSuccess(api) {{
              sketchfabApi = api;
              api.start();
              api.addEventListener('viewerready', function () {{
                console.log('Sketchfab {m["title"]} 3D Viewer Ready');
                showToast('{m["title"]} 3D Model Loaded');
              }});
            }},
            error: function onError() {{
              console.warn('Sketchfab API init fallback to standard iframe embed.');
            }},
            autostart: 1,
            ui_controls: 1,
            ui_infos: 0,
            ui_watermark: 0,
            ui_ar: 1,
            ui_vr: 1,
            ui_theatre: 1,
            preload: 1
          }});
        }} catch (err) {{
          console.log('Sketchfab client initialized directly via iframe src.');
        }}
      }}

      // Dock Camera Presets
      var dockBtns = document.querySelectorAll('.dock-btn');
      function setDockActive(btn) {{
        dockBtns.forEach(function (b) {{ b.classList.remove('active'); }});
        if (btn) btn.classList.add('active');
      }}

{views_js}
      // Fade out orbit hint after 8 seconds
      setTimeout(function () {{
        var hint = document.getElementById('orbit-hint');
        if (hint) hint.style.opacity = '0';
      }}, 8000);

    }})();
  </script>
</body>
</html>
'''

# ── 4. BUILD ALL STANDALONE 3D FILES ──────────────────────────────────────
print("Building all 13 standalone Sketchfab models...")
for m in sketchfab_monuments:
    html = generate_standalone_html(m)
    p1 = os.path.join(workspace_dir, m["filename"])
    with open(p1, "w", encoding="utf-8") as f:
        f.write(html)
    
    if m.get("alias_filename"):
        p2 = os.path.join(workspace_dir, m["alias_filename"])
        with open(p2, "w", encoding="utf-8") as f:
            f.write(html)
    print(f" [OK] Built {m['filename']} (UID: {m['uid']})")

# Also ensure aliases for Three.js models
for t in threejs_monuments:
    src = os.path.join(workspace_dir, t["file"])
    dst = os.path.join(workspace_dir, t["alias_file"])
    if os.path.exists(src) and not os.path.exists(dst):
        shutil.copyfile(src, dst)
        print(f" [OK] Created alias {t['alias_file']} from {t['file']}")

# ── 5. BUILD MASTER ALL_3D_MODELS.HTML & MODELS_HUB.HTML ──────────────────
# Combine all 13 Sketchfab + 3 Three.js models for the master hub (total 16)
combined_catalog = []

for m in sketchfab_monuments:
    combined_catalog.append({
        "id": m["id"],
        "title": m["title"],
        "hindi": m["hindi_title"],
        "state": m["state"].title(),
        "region": m["region"],
        "era": m["era"],
        "uid": m["uid"],
        "whom_made": m["whom_made"],
        "picked_from": m["picked_from"],
        "file": m["filename"],
        "thumb": m["thumb"],
        "badge": m["badge"],
        "desc": m["desc"],
        "type": "sketchfab",
        "drone_freqs": m["drone_freqs"]
    })

for t in threejs_monuments:
    combined_catalog.append({
        "id": t["id"],
        "title": t["title"],
        "hindi": t["hindi"],
        "state": t["state"],
        "region": t["region"],
        "era": t["era"],
        "uid": None,
        "whom_made": t["whom_made"],
        "picked_from": t["picked_from"],
        "file": t["file"],
        "thumb": t["thumb"],
        "badge": t["badge"],
        "desc": t["desc"],
        "type": "webgl",
        "drone_freqs": t["drone_freqs"]
    })

print(f"Master Catalog prepared with {len(combined_catalog)} total monuments.")

hub_template = f'''<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>3D Heritage Vault — All Interactive Models | YUGMA</title>
  <meta name="description" content="Explore India's most iconic architectural wonders in photorealistic 3D WebXR. Switch seamlessly between 16 interactive national monuments.">

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;900&family=Cormorant+Garamond:wght@600;700&family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

  <style>
    :root {{
      --bg-dark: #06090e;
      --gold: #dfa753;
      --gold-bright: #ffd56b;
      --gold-glow: rgba(223, 167, 83, 0.45);
      --glass-bg: rgba(9, 14, 23, 0.85);
      --glass-border: rgba(223, 167, 83, 0.32);
      --glass-card: rgba(13, 20, 32, 0.92);
      --ease: cubic-bezier(0.16, 1, 0.3, 1);
    }}

    * {{
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      user-select: none;
      -webkit-user-select: none;
    }}

    html, body {{
      width: 100%;
      height: 100%;
      overflow: hidden;
      background: var(--bg-dark);
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
      color: #f8fafc;
    }}

    /* Main 3D Viewport Frame */
    #viewer-stage {{
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      z-index: 1;
      background: radial-gradient(circle at 50% 40%, #151d2a 0%, #080a0f 85%, #040507 100%);
      transition: filter 0.8s ease;
    }}

    #sketchfab-frame {{
      position: absolute;
      top: -54px;
      left: 0;
      width: 100%;
      height: calc(100% + 108px);
      border: none;
      display: block;
    }}

    /* Corner Shields to eliminate owner avatar/name in top-left and Sketchfab logo in bottom-left */
    .brand-shield-top-left {{
      position: fixed;
      top: 0;
      left: 0;
      width: 260px;
      height: 62px;
      z-index: 11;
      pointer-events: none;
      background: linear-gradient(135deg, rgba(7, 9, 14, 0.96) 0%, rgba(7, 9, 14, 0.72) 45%, transparent 100%);
    }}

    .brand-shield-bottom-left {{
      position: fixed;
      bottom: 0;
      left: 0;
      min-width: 210px;
      height: 52px;
      z-index: 12;
      pointer-events: auto;
      display: flex;
      align-items: center;
      padding-left: 20px;
      padding-bottom: 4px;
      background: linear-gradient(45deg, rgba(7, 9, 14, 0.96) 0%, rgba(7, 9, 14, 0.75) 50%, transparent 100%);
      border-top-right-radius: 12px;
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
    }}
    .brand-shield-badge {{
      display: inline-flex;
      align-items: center;
      gap: 7px;
      font-family: 'Cinzel', serif;
      font-size: 10px;
      letter-spacing: 1.2px;
      font-weight: 700;
      color: var(--gold-bright, #ffd56b);
      text-transform: uppercase;
      text-shadow: 0 1px 4px rgba(0,0,0,0.8);
      user-select: none;
    }}
    .brand-shield-badge i {{
      color: var(--gold, #dfa753);
      font-size: 11px;
    }}

    /* Atmosphere Lighting Presets */
    .atmos-dawn {{
      filter: sepia(0.25) saturate(1.3) hue-rotate(-12deg) brightness(1.05) contrast(1.04);
    }}
    .atmos-noon {{
      filter: contrast(1.06) brightness(1.08) saturate(1.02);
    }}
    .atmos-sunset {{
      filter: sepia(0.55) saturate(1.6) hue-rotate(-22deg) contrast(1.12) brightness(0.98);
    }}
    .atmos-moonlight {{
      filter: brightness(0.85) contrast(1.2) hue-rotate(185deg) saturate(0.65);
    }}

    #vignette {{
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 2;
      box-shadow: inset 0 0 100px rgba(0,0,0,0.7), inset 0 0 240px rgba(3,5,8,0.9);
    }}

    /* Top Navigation Header */
    .header-bar {{
      position: fixed;
      top: 18px;
      left: 20px;
      right: 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      z-index: 25;
      pointer-events: none;
    }}

    .nav-group {{
      display: flex;
      align-items: center;
      gap: 10px;
      pointer-events: auto;
    }}

    .nav-btn {{
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 9px 18px;
      background: var(--glass-bg);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid var(--glass-border);
      border-radius: 30px;
      color: #f8fafc;
      text-decoration: none;
      font-size: 11.5px;
      font-weight: 600;
      letter-spacing: 0.8px;
      transition: all 0.25s var(--ease);
      box-shadow: 0 8px 24px rgba(0,0,0,0.45);
      cursor: pointer;
    }}

    .nav-btn:hover {{
      background: rgba(223, 167, 83, 0.22);
      border-color: var(--gold-bright);
      color: var(--gold-bright);
      transform: translateY(-2px);
      box-shadow: 0 12px 28px rgba(223, 167, 83, 0.25);
    }}
    .nav-btn i {{
      color: var(--gold);
      font-size: 13px;
    }}

    .brand-tag {{
      display: flex;
      flex-direction: column;
      padding: 7px 16px;
      background: rgba(11, 16, 26, 0.75);
      backdrop-filter: blur(12px);
      border: 1px solid rgba(223, 167, 83, 0.25);
      border-radius: 10px;
    }}
    .brand-tag span:first-child {{
      font-family: 'Space Grotesk', sans-serif;
      font-size: 9.5px;
      font-weight: 700;
      letter-spacing: 2.2px;
      color: var(--gold-bright);
      text-transform: uppercase;
    }}
    .brand-tag span:last-child {{
      font-size: 11px;
      color: #94a3b8;
      font-weight: 500;
    }}

    /* Left Active Monument Card */
    #info-card {{
      position: fixed;
      top: 82px;
      left: 20px;
      max-width: 380px;
      background: var(--glass-card);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid var(--glass-border);
      border-radius: 20px;
      padding: 22px 24px;
      color: #f8fafc;
      z-index: 15;
      box-shadow: 0 16px 40px rgba(0,0,0,0.65), 0 0 25px rgba(223, 167, 83, 0.12);
      transition: all 0.35s var(--ease);
    }}

    #info-card.collapsed {{
      transform: translateY(-10px);
      padding: 12px 18px;
    }}
    #info-card.collapsed .card-body {{
      display: none;
    }}

    .badge-label {{
      font-family: 'Space Grotesk', sans-serif;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: var(--gold);
      display: block;
      margin-bottom: 4px;
    }}

    h1.active-title {{
      font-family: 'Cinzel', serif;
      font-weight: 700;
      font-size: 26px;
      line-height: 1.15;
      background: linear-gradient(135deg, #ffffff 0%, #fff1d0 50%, #dfa753 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }}

    .hindi-text {{
      font-family: 'Cormorant Garamond', serif;
      font-size: 17px;
      font-weight: 600;
      color: rgba(223, 167, 83, 0.85);
      margin-left: 6px;
      -webkit-text-fill-color: initial;
    }}

    .collapse-btn {{
      background: rgba(255,255,255,0.06);
      border: 1px solid rgba(223, 167, 83, 0.25);
      color: var(--gold);
      border-radius: 50%;
      width: 26px;
      height: 26px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      font-size: 12px;
      transition: all 0.2s;
    }}
    .collapse-btn:hover {{
      background: var(--gold);
      color: #04070a;
    }}

    .active-desc {{
      font-size: 12.8px;
      line-height: 1.6;
      color: #cbd5e1;
      margin-top: 10px;
    }}

    .action-links {{
      display: flex;
      gap: 10px;
      margin-top: 16px;
      padding-top: 14px;
      border-top: 1px solid rgba(223, 167, 83, 0.2);
    }}

    .launch-btn {{
      flex: 1;
      padding: 9px 14px;
      background: linear-gradient(135deg, #dfa753 0%, #c98845 100%);
      border: none;
      border-radius: 10px;
      color: #06090f;
      font-weight: 700;
      font-size: 11.5px;
      letter-spacing: 0.5px;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      transition: all 0.2s var(--ease);
      box-shadow: 0 4px 14px rgba(223, 167, 83, 0.35);
    }}
    .launch-btn:hover {{
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(223, 167, 83, 0.5);
      color: #000;
    }}

    /* Bottom Interactive Carousel */
    #bottom-dock {{
      position: fixed;
      bottom: 20px;
      left: 50%;
      transform: translateX(-50%);
      z-index: 20;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
      max-width: 98vw;
      width: 100%;
    }}

    .filter-bar {{
      display: flex;
      gap: 6px;
      background: rgba(11, 16, 26, 0.85);
      backdrop-filter: blur(14px);
      padding: 4px 8px;
      border-radius: 30px;
      border: 1px solid rgba(223, 167, 83, 0.25);
    }}

    .filter-btn {{
      padding: 5px 12px;
      background: transparent;
      border: none;
      border-radius: 20px;
      color: #94a3b8;
      font-size: 11px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s;
    }}
    .filter-btn.active {{
      background: var(--gold);
      color: #06090f;
      font-weight: 700;
    }}

    /* Model Cards Carousel Strip */
    .carousel-wrap {{
      display: flex;
      gap: 12px;
      overflow-x: auto;
      padding: 8px 12px;
      max-width: 96vw;
      scrollbar-width: thin;
      scrollbar-color: var(--gold) transparent;
      background: var(--glass-card);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid var(--glass-border);
      border-radius: 20px;
      box-shadow: 0 16px 40px rgba(0,0,0,0.65);
    }}

    .model-card {{
      display: flex;
      align-items: center;
      gap: 10px;
      min-width: 220px;
      padding: 8px 10px;
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 12px;
      cursor: pointer;
      transition: all 0.25s var(--ease);
      flex-shrink: 0;
    }}

    .model-card:hover {{
      background: rgba(223, 167, 83, 0.14);
      border-color: var(--gold);
      transform: translateY(-3px);
    }}

    .model-card.active {{
      background: linear-gradient(135deg, rgba(223, 167, 83, 0.3) 0%, rgba(201, 136, 69, 0.3) 100%);
      border-color: var(--gold-bright);
      box-shadow: 0 4px 16px rgba(223, 167, 83, 0.35);
    }}

    .card-thumb {{
      width: 48px;
      height: 48px;
      border-radius: 8px;
      object-fit: cover;
      border: 1px solid rgba(223, 167, 83, 0.3);
      flex-shrink: 0;
    }}

    .card-meta {{
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }}
    .card-state {{
      font-size: 9px;
      font-weight: 700;
      letter-spacing: 1.2px;
      text-transform: uppercase;
      color: var(--gold);
    }}
    .card-title {{
      font-family: 'Cinzel', serif;
      font-size: 12.5px;
      font-weight: 700;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      color: #f8fafc;
    }}
    .card-creator {{
      font-size: 9px;
      color: #94a3b8;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }}

    /* Gallery Modal (Grid Mode) */
    #gallery-modal {{
      position: fixed;
      inset: 0;
      background: rgba(6, 9, 14, 0.95);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      z-index: 100;
      display: none;
      flex-direction: column;
      padding: 30px;
      overflow-y: auto;
    }}
    #gallery-modal.open {{
      display: flex;
    }}

    .gallery-header {{
      display: flex;
      justify-content: space-between;
      align-items: center;
      max-width: 1400px;
      width: 100%;
      margin: 0 auto 24px auto;
    }}
    .gallery-title {{
      font-family: 'Cinzel', serif;
      font-size: 28px;
      color: var(--gold-bright);
    }}
    .gallery-grid {{
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 20px;
      max-width: 1400px;
      width: 100%;
      margin: 0 auto;
    }}
    .grid-card {{
      background: var(--glass-card);
      border: 1px solid var(--glass-border);
      border-radius: 16px;
      overflow: hidden;
      transition: all 0.3s var(--ease);
      display: flex;
      flex-direction: column;
    }}
    .grid-card:hover {{
      transform: translateY(-6px);
      border-color: var(--gold);
      box-shadow: 0 16px 36px rgba(223, 167, 83, 0.25);
    }}
    .grid-card-img {{
      width: 100%;
      height: 180px;
      object-fit: cover;
      border-bottom: 1px solid rgba(223, 167, 83, 0.2);
    }}
    .grid-card-body {{
      padding: 16px;
      flex: 1;
      display: flex;
      flex-direction: column;
    }}
    .grid-card-tag {{
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 1.5px;
      color: var(--gold);
      text-transform: uppercase;
      margin-bottom: 4px;
    }}
    .grid-card-title {{
      font-family: 'Cinzel', serif;
      font-size: 17px;
      color: #fff;
      margin-bottom: 6px;
    }}
    .grid-card-desc {{
      font-size: 12px;
      line-height: 1.5;
      color: #94a3b8;
      margin-bottom: 14px;
      flex: 1;
    }}
    .grid-card-btn {{
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      padding: 8px 14px;
      background: linear-gradient(135deg, #dfa753 0%, #c98845 100%);
      color: #06090f;
      font-weight: 700;
      font-size: 11px;
      text-decoration: none;
      border-radius: 8px;
      transition: all 0.2s;
    }}
    .grid-card-btn:hover {{
      background: #ffd56b;
      color: #000;
    }}

    /* Toast */
    #toast {{
      position: fixed;
      top: 80px;
      left: 50%;
      transform: translateX(-50%);
      background: var(--glass-card);
      border: 1px solid var(--gold);
      border-radius: 30px;
      padding: 10px 22px;
      color: var(--gold-bright);
      font-size: 12.5px;
      font-weight: 600;
      box-shadow: 0 10px 30px rgba(0,0,0,0.6);
      z-index: 60;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s, transform 0.3s;
    }}
    #toast.show {{
      opacity: 1;
      transform: translateX(-50%) translateY(5px);
    }}

    @media (max-width: 768px) {{
      #info-card {{
        top: 72px;
        left: 10px;
        right: 10px;
        max-width: none;
      }}
      .brand-tag {{
        display: none;
      }}
    }}
  </style>
</head>
<body>

  <!-- 3D Viewport Stage -->
  <div id="viewer-stage" class="atmos-noon">
    <iframe
      id="sketchfab-frame"
      title="3D Heritage Viewer"
      src="https://sketchfab.com/models/7b43e635cbfb47719d5a124302b78579/embed?autostart=1&internal=1&tracking=0&ui_ar=1&ui_infos=0&ui_snapshots=1&ui_stop=0&ui_theatre=1&ui_watermark=0&ui_theme=dark&camera=0&preload=1"
      allow="autoplay; fullscreen; xr-spatial-tracking; web-share"
      xr-spatial-tracking="true"
      execution-while-out-of-viewport="true"
      execution-while-not-rendered="true"
      web-share="true"
      allowfullscreen
      mozallowfullscreen="true"
      webkitallowfullscreen="true">
    </iframe>
  </div>

  <div id="vignette"></div>

  <!-- Header Bar -->
  <header class="header-bar">
    <div class="nav-group">
      <a href="index.html" class="nav-btn" title="Return to India 3D Globe">
        <i class="fa-solid fa-arrow-left"></i>
        <span>3D GLOBE</span>
      </a>
      <a href="india_3d_map.html" class="nav-btn" title="Open Interactive 3D Map">
        <i class="fa-solid fa-map-location-dot"></i>
        <span>INDIA MAP</span>
      </a>
      <button class="nav-btn" id="btn-gallery-toggle" style="background: rgba(223, 167, 83, 0.25); border-color: var(--gold-bright); color: var(--gold-bright);" title="Open 3D Grid Catalog">
        <i class="fa-solid fa-grid-2"></i>
        <span>CATALOG GRID</span>
      </button>
      <div class="brand-tag">
        <span>3D HERITAGE VAULT</span>
        <span>{len(combined_catalog)} INTERACTIVE MODELS</span>
      </div>
    </div>

    <div class="nav-group">
      <button class="nav-btn" id="btn-audio" title="Toggle Regional Heritage Ambience">
        <i class="fa-solid fa-volume-high" id="audio-icon"></i>
        <span id="audio-text">AMBIENCE</span>
      </button>

      <button class="nav-btn" id="btn-fullscreen" title="Toggle Fullscreen">
        <i class="fa-solid fa-expand"></i>
      </button>
    </div>
  </header>

  <!-- Left Active Info Card -->
  <aside id="info-card">
    <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:6px;">
      <div>
        <span class="badge-label" id="card-badge">{combined_catalog[0]["badge"]}</span>
        <h1 class="active-title" id="card-title">{combined_catalog[0]["title"]} <span class="hindi-text" id="card-hindi">({combined_catalog[0]["hindi"]})</span></h1>
      </div>
      <button class="collapse-btn" id="collapse-btn" aria-label="Toggle details">
        <i class="fa-solid fa-chevron-up"></i>
      </button>
    </div>

    <div class="card-body">
      <p class="active-desc" id="card-desc">
        {combined_catalog[0]["desc"]}
      </p>

      <div style="display:grid; grid-template-columns:repeat(2,1fr); gap:8px; margin-top:12px; font-size:11px; color:#94a3b8;">
        <div>STATE: <strong style="color:#ffd56b;" id="card-state">{combined_catalog[0]["state"]}</strong></div>
        <div>ERA: <strong style="color:#ffd56b;" id="card-era">{combined_catalog[0]["era"]}</strong></div>
      </div>

      <div class="heritage-provenance-hub" style="margin-top:12px; padding:10px 12px; background:rgba(223,167,83,0.08); border:1px solid rgba(223,167,83,0.22); border-radius:8px; display:flex; flex-direction:column; gap:6px; font-size:11px;">
        <div style="display:flex; justify-content:space-between; gap:10px; align-items:baseline;">
          <span style="color:#94a3b8; font-size:9px; text-transform:uppercase; letter-spacing:0.8px; font-weight:600;"><i class="fa-solid fa-monument" style="color:var(--gold);"></i> BUILT FOR:</span>
          <strong style="color:#ffd56b; text-align:right;" id="card-whom">{combined_catalog[0]["whom_made"]}</strong>
        </div>
        <div style="display:flex; justify-content:space-between; gap:10px; align-items:baseline;">
          <span style="color:#94a3b8; font-size:9px; text-transform:uppercase; letter-spacing:0.8px; font-weight:600;"><i class="fa-solid fa-location-dot" style="color:var(--gold);"></i> PICKED FROM:</span>
          <strong style="color:#ffd56b; text-align:right;" id="card-picked">{combined_catalog[0]["picked_from"]}</strong>
        </div>
      </div>

      <div class="action-links">
        <a id="card-launch" href="{combined_catalog[0]["file"]}" class="launch-btn" title="Launch dedicated immersive viewer">
          <i class="fa-solid fa-vr-cardboard"></i>
          <span>OPEN DEDICATED VIEW</span>
        </a>
      </div>
    </div>
  </aside>

  <!-- Bottom Dock & Carousel Strip -->
  <div id="bottom-dock">
    <!-- Filter Bar -->
    <div class="filter-bar">
      <button class="filter-btn active" data-filter="all">All ({len(combined_catalog)})</button>
      <button class="filter-btn" data-filter="North">North</button>
      <button class="filter-btn" data-filter="South">South</button>
      <button class="filter-btn" data-filter="West">West</button>
      <button class="filter-btn" data-filter="East">East</button>
      <button class="filter-btn" data-filter="Central">Central</button>
    </div>

    <!-- Carousel Strip -->
    <div class="carousel-wrap" id="carousel">
'''

for idx, m in enumerate(combined_catalog):
    hub_template += f'''      <div class="model-card{" active" if idx == 0 else ""}" data-id="{m["id"]}" data-region="{m["region"]}">
        <img src="{m["thumb"]}" alt="{m["title"]}" class="card-thumb">
        <div class="card-meta">
          <span class="card-state">{m["state"]}</span>
          <span class="card-title">{m["title"]}</span>
          <span class="card-creator">{m["era"]}</span>
        </div>
      </div>\n'''

hub_template += f'''    </div>
  </div>

  <!-- Grid Catalog Modal -->
  <div id="gallery-modal">
    <div class="gallery-header">
      <div>
        <h2 class="gallery-title">All {len(combined_catalog)} National 3D Models</h2>
        <p style="color:#94a3b8; font-size:13px; margin-top:4px;">Direct access to all photorealistic digital twins and WebXR simulations across India</p>
      </div>
      <button class="collapse-btn" id="btn-gallery-close" style="width:36px; height:36px; font-size:16px;">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <div class="gallery-grid">
'''

for m in combined_catalog:
    hub_template += f'''      <div class="grid-card">
        <img src="{m["thumb"]}" alt="{m["title"]}" class="grid-card-img">
        <div class="grid-card-body">
          <span class="grid-card-tag">{m["region"]} India · {m["state"]}</span>
          <h3 class="grid-card-title">{m["title"]}</h3>
          <p class="grid-card-desc">{m["desc"]}</p>
          <div style="margin-bottom:12px; font-size:11px; color:#cbd5e1; display:flex; flex-direction:column; gap:4px; border-top:1px solid rgba(223,167,83,0.15); padding-top:8px;">
            <div><span style="color:#94a3b8; font-size:9px; text-transform:uppercase; font-weight:600;">Built For:</span> <strong style="color:#ffd56b;">{m["whom_made"]}</strong></div>
            <div><span style="color:#94a3b8; font-size:9px; text-transform:uppercase; font-weight:600;">Picked From:</span> <strong style="color:#ffd56b;">{m["picked_from"]}</strong></div>
          </div>
          <div style="display:flex; gap:8px;">
            <button class="grid-card-btn select-monument-btn" data-id="{m["id"]}" style="flex:1; cursor:pointer; border:none;">
              <i class="fa-solid fa-eye"></i> View on Stage
            </button>
            <a href="{m["file"]}" class="grid-card-btn" style="background:rgba(255,255,255,0.08); color:#ffd56b; border:1px solid rgba(223,167,83,0.3);">
              <i class="fa-solid fa-arrow-up-right-from-square"></i>
            </a>
          </div>
        </div>
      </div>\n'''

hub_template += f'''    </div>
  </div>

  <div id="toast">3D Model Loaded</div>

  <script>
    const MONUMENTS = {json.dumps(combined_catalog, indent=2)};

    (function() {{
      "use strict";

      const iframe = document.getElementById('sketchfab-frame');
      const toast = document.getElementById('toast');
      const infoCard = document.getElementById('info-card');
      const collapseBtn = document.getElementById('collapse-btn');
      const cardBadge = document.getElementById('card-badge');
      const cardTitle = document.getElementById('card-title');
      const cardHindi = document.getElementById('card-hindi');
      const cardDesc = document.getElementById('card-desc');
      const cardState = document.getElementById('card-state');
      const cardEra = document.getElementById('card-era');
      const cardLaunch = document.getElementById('card-launch');
      const fullscreenBtn = document.getElementById('btn-fullscreen');
      const audioBtn = document.getElementById('btn-audio');
      const audioIcon = document.getElementById('audio-icon');
      const audioText = document.getElementById('audio-text');
      const galleryModal = document.getElementById('gallery-modal');
      const galleryToggle = document.getElementById('btn-gallery-toggle');
      const galleryClose = document.getElementById('btn-gallery-close');

      let currentModel = MONUMENTS[0];

      function showToast(msg) {{
        toast.textContent = msg;
        toast.classList.add('show');
        clearTimeout(toast._timer);
        toast._timer = setTimeout(() => toast.classList.remove('show'), 2200);
      }}

      // Switch active model
      window.selectMonument = function(id) {{
        const m = MONUMENTS.find(x => x.id === id);
        if (!m) return;
        currentModel = m;

        // Update cards
        document.querySelectorAll('.model-card').forEach(c => {{
          c.classList.toggle('active', c.getAttribute('data-id') === id);
        }});

        // Update card info
        cardBadge.textContent = m.badge;
        cardTitle.firstChild.textContent = m.title + ' ';
        cardHindi.textContent = '(' + m.hindi + ')';
        cardDesc.textContent = m.desc;
        cardState.textContent = m.state;
        cardEra.textContent = m.era;
        const cardWhom = document.getElementById('card-whom');
        const cardPicked = document.getElementById('card-picked');
        if (cardWhom) cardWhom.textContent = m.whom_made;
        if (cardPicked) cardPicked.textContent = m.picked_from;
        cardLaunch.href = m.file;

        // Change iframe src
        if (m.type === 'sketchfab' && m.uid) {{
          iframe.src = `https://sketchfab.com/models/${{m.uid}}/embed?autostart=1&internal=1&tracking=0&ui_ar=1&ui_infos=0&ui_snapshots=1&ui_stop=0&ui_theatre=1&ui_watermark=0&ui_theme=dark&camera=0&preload=1`;
        }} else {{
          iframe.src = m.file;
        }}
        showToast(`${{m.title}} (${{m.state}}) Loaded`);

        // If audio playing, restart with new frequencies
        if (isAudioPlaying) {{
          stopAmbience();
          startAmbience();
        }}
      }};

      // Card clicks
      document.querySelectorAll('.model-card').forEach(card => {{
        card.addEventListener('click', () => {{
          const id = card.getAttribute('data-id');
          selectMonument(id);
        }});
      }});

      // Grid view clicks
      document.querySelectorAll('.select-monument-btn').forEach(btn => {{
        btn.addEventListener('click', () => {{
          const id = btn.getAttribute('data-id');
          selectMonument(id);
          galleryModal.classList.remove('open');
        }});
      }});

      // Gallery Modal Toggle
      galleryToggle.addEventListener('click', () => {{
        galleryModal.classList.add('open');
      }});
      galleryClose.addEventListener('click', () => {{
        galleryModal.classList.remove('open');
      }});

      // Region Filter clicks
      document.querySelectorAll('.filter-btn').forEach(btn => {{
        btn.addEventListener('click', () => {{
          document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          const filter = btn.getAttribute('data-filter');
          document.querySelectorAll('.model-card').forEach(card => {{
            const reg = card.getAttribute('data-region');
            card.style.display = (filter === 'all' || reg === filter) ? 'flex' : 'none';
          }});
        }});
      }});

      // Collapse toggle
      collapseBtn.addEventListener('click', () => {{
        infoCard.classList.toggle('collapsed');
        const isCollapsed = infoCard.classList.contains('collapsed');
        collapseBtn.innerHTML = isCollapsed ? '<i class="fa-solid fa-chevron-down"></i>' : '<i class="fa-solid fa-chevron-up"></i>';
      }});

      // Fullscreen
      fullscreenBtn.addEventListener('click', () => {{
        if (!document.fullscreenElement) {{
          document.documentElement.requestFullscreen().catch(() => {{}});
          fullscreenBtn.innerHTML = '<i class="fa-solid fa-compress"></i>';
        }} else {{
          document.exitFullscreen().catch(() => {{}});
          fullscreenBtn.innerHTML = '<i class="fa-solid fa-expand"></i>';
        }}
      }});

      // Audio Synthesizer Engine
      let audioCtx = null;
      let isAudioPlaying = false;
      let ambientNodes = [];

      function startAmbience() {{
        try {{
          const AudioContext = window.AudioContext || window.webkitAudioContext;
          if (!audioCtx) audioCtx = new AudioContext();
          if (audioCtx.state === 'suspended') audioCtx.resume();

          const masterGain = audioCtx.createGain();
          masterGain.gain.setValueAtTime(0.01, audioCtx.currentTime);
          masterGain.gain.exponentialRampToValueAtTime(0.18, audioCtx.currentTime + 2.5);
          masterGain.connect(audioCtx.destination);
          ambientNodes.push(masterGain);

          const baseFreqs = currentModel.drone_freqs || [138.59, 207.65, 277.18, 415.30];
          baseFreqs.forEach((f, idx) => {{
            const osc = audioCtx.createOscillator();
            const oscGain = audioCtx.createGain();
            osc.type = idx % 2 === 0 ? 'sine' : 'triangle';
            osc.frequency.setValueAtTime(f, audioCtx.currentTime);

            const lfo = audioCtx.createOscillator();
            lfo.frequency.setValueAtTime(0.2 + idx * 0.1, audioCtx.currentTime);
            const lfoGain = audioCtx.createGain();
            lfoGain.gain.setValueAtTime(1.5, audioCtx.currentTime);
            lfo.connect(lfoGain);
            lfoGain.connect(osc.frequency);
            lfo.start();

            oscGain.gain.setValueAtTime(0.04 / (idx + 1), audioCtx.currentTime);
            osc.connect(oscGain);
            oscGain.connect(masterGain);
            osc.start();
            ambientNodes.push(osc, lfo);
          }});

          // Shimmer Air Filter
          const bufferSize = audioCtx.sampleRate * 2;
          const noiseBuffer = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate);
          const output = noiseBuffer.getChannelData(0);
          for (let i = 0; i < bufferSize; i++) output[i] = Math.random() * 2 - 1;
          const whiteNoise = audioCtx.createBufferSource();
          whiteNoise.buffer = noiseBuffer;
          whiteNoise.loop = true;

          const biquad = audioCtx.createBiquadFilter();
          biquad.type = 'bandpass';
          biquad.frequency.setValueAtTime(1100, audioCtx.currentTime);
          biquad.Q.setValueAtTime(1.4, audioCtx.currentTime);

          const noiseGain = audioCtx.createGain();
          noiseGain.gain.setValueAtTime(0.02, audioCtx.currentTime);

          whiteNoise.connect(biquad);
          biquad.connect(noiseGain);
          noiseGain.connect(masterGain);
          whiteNoise.start();
          ambientNodes.push(whiteNoise);

          isAudioPlaying = true;
          audioIcon.className = 'fa-solid fa-volume-high';
          audioText.textContent = 'SOUND ON';
          audioBtn.style.borderColor = 'var(--gold-bright)';
          audioBtn.style.color = 'var(--gold-bright)';
          showToast(`${{currentModel.title}} Ambience Playing`);
        }} catch(e) {{
          console.warn('Audio not allowed:', e);
        }}
      }}

      function stopAmbience() {{
        ambientNodes.forEach(n => {{
          try {{ if (n.stop) n.stop(); if (n.disconnect) n.disconnect(); }} catch(e) {{}}
        }});
        ambientNodes = [];
        isAudioPlaying = false;
        audioIcon.className = 'fa-solid fa-volume-xmark';
        audioText.textContent = 'MUTED';
        audioBtn.style.borderColor = 'var(--glass-border)';
        audioBtn.style.color = '#f8fafc';
        showToast('Ambience Muted');
      }}

      audioBtn.addEventListener('click', () => {{
        if (!isAudioPlaying) startAmbience();
        else stopAmbience();
      }});

    }})();
  </script>
</body>
</html>
'''

# Write master all_3d_models.html & models_hub.html
