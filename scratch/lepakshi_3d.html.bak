  <script id="vg-engine-script">
  (function () {
    "use strict";

    var SITE_NAME = "Lepakshi Veerabhadra Temple";
    var SUPPORTED_LANGS = [
      { key: 'en', code: 'en-IN', fallback: 'en-US', label: 'English', flag: '🇬🇧' },
