<!DOCTYPE html>
<html lang="en">
<head>
  <meta name="referrer" content="no-referrer">

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
<title>Lepakshi — Veerabhadra Temple | Interactive 3D / VR</title>
<style>
  :root{
    --stone-light:#a99a83;
    --stone-mid:#7d6f5c;
    --stone-dark:#3c342a;
    --ochre:#a8552b;
    --gold:#c99a3d;
    --maroon:#5e1f1c;
    --ink:#20180f;
    --paper:#f4ead9;
  }
  *{box-sizing:border-box;}
  html,body{
    margin:0; padding:0; width:100%; height:100%;
    background:#0c0d16;
    font-family:'Inter', system-ui, sans-serif;
    overflow:hidden;
    color:var(--paper);
  }
  #canvas-wrap{position:fixed; inset:0;}
  canvas{display:block; touch-action:none;}

  #hero{
    position:fixed; top:0; left:0; right:0;
    padding:22px 26px 60px 26px;
    pointer-events:none;
    background:linear-gradient(180deg, rgba(12,13,22,0.75) 0%, rgba(12,13,22,0.35) 55%, rgba(12,13,22,0) 100%);
    z-index:5;
  }
  #hero h1{
    font-family:'Cinzel', 'Georgia', serif;
    font-weight:600;
    letter-spacing:0.04em;
    font-size:clamp(22px,4.2vw,34px);
    margin:0 0 4px 0;
    color:var(--paper);
    text-shadow:0 2px 10px rgba(0,0,0,0.5);
  }
  #hero p{
    margin:0;
    font-size:13px;
    letter-spacing:0.05em;
    color:#d9c7a8;
    text-transform:uppercase;
    opacity:0.85;
  }

  #legend{
    position:fixed; bottom:16px; left:16px;
    font-size:11.5px; color:#cbb997; opacity:0.75;
    letter-spacing:0.02em;
    z-index:5;
    max-width:230px;
    line-height:1.5;
  }

  #hotspots{position:fixed; inset:0; pointer-events:none; z-index:4;}
  .hotspot{
    position:absolute; width:16px; height:16px; margin:-8px 0 0 -8px;
    border-radius:50%;
    background:radial-gradient(circle at 35% 30%, #f2d98a, var(--gold));
    box-shadow:0 0 0 4px rgba(201,154,61,0.22), 0 0 14px rgba(201,154,61,0.7);
    pointer-events:auto;
    cursor:pointer;
    animation:pulse 2.4s ease-in-out infinite;
    border:1px solid rgba(255,255,255,0.4);
  }
  @keyframes pulse{
    0%,100%{transform:scale(1);}
    50%{transform:scale(1.28);}
  }

  #panel{
    position:fixed; right:18px; bottom:18px; z-index:6;
    width:min(340px, 86vw);
    background:linear-gradient(160deg, rgba(32,24,15,0.94), rgba(20,15,10,0.96));
    border:1px solid rgba(201,154,61,0.35);
    border-radius:6px;
    padding:18px 20px 16px 20px;
    transform:translateY(140%);
    transition:transform 0.5s cubic-bezier(.2,.9,.25,1);
    box-shadow:0 20px 60px rgba(0,0,0,0.5);
  }
  #panel.open{transform:translateY(0);}
  #panel .eyebrow{
    font-size:10.5px; letter-spacing:0.14em; text-transform:uppercase;
    color:var(--gold); margin:0 0 6px 0;
  }
  #panel h2{
    font-family:'Cinzel','Georgia',serif; font-weight:600;
    font-size:19px; margin:0 0 8px 0; color:var(--paper);
  }
  #panel p{
    font-size:13.5px; line-height:1.55; color:#e4d7bd; margin:0 0 12px 0;
  }
  #panel button.action{
    background:transparent; border:1px solid var(--gold); color:var(--gold);
    font-size:11.5px; letter-spacing:0.06em; text-transform:uppercase;
    padding:8px 14px; border-radius:3px; cursor:pointer;
    font-family:inherit;
  }
  #panel button.action:hover{background:rgba(201,154,61,0.15);}
  #panel .close{
    position:absolute; top:10px; right:12px; background:none; border:none;
    color:#a99a83; font-size:16px; cursor:pointer; pointer-events:auto;
  }

  #controls-hint{
    position:fixed; top:18px; right:18px; z-index:5;
    font-size:11px; color:#cbb997; opacity:0.7; text-align:right;
    letter-spacing:0.02em; line-height:1.6;
    pointer-events:none;
  }

  #loading{
    position:fixed; inset:0; z-index:20; background:#0c0d16;
    display:flex; align-items:center; justify-content:center; flex-direction:column;
    transition:opacity 0.6s ease;
  }
  #loading .glyph{
    width:46px; height:46px; border-radius:50%;
    border:2px solid rgba(201,154,61,0.25); border-top-color:var(--gold);
    animation:spin 1s linear infinite; margin-bottom:16px;
  }
  #loading span{font-size:12px; letter-spacing:0.14em; text-transform:uppercase; color:#cbb997;}
  @keyframes spin{to{transform:rotate(360deg);}}

  #vr-btn-wrap{position:fixed; bottom:18px; left:50%; transform:translateX(-50%); z-index:6;}

  @media (max-width:560px){
    #hero{padding:16px 16px 40px 16px;}
    #controls-hint{display:none;}
    #legend{display:none;}
  }

    </style>

  

  

  
  
  <style id="vg-master-styles">

    /* ════ RIGHT-SIDE DOCKED HERITAGE VOICE GUIDE SYSTEM ════ */

    /* ── Floating Microphone Trigger (Icon-Only, Same Bottom-Right Position) ── */
    .voice-guide-fab {
      position: fixed;
      bottom: 28px;
      right: 28px;
      width: 58px;
      height: 58px;
      border-radius: 50%;
      background: linear-gradient(135deg, #f59e0b, #d97706);
      border: 2px solid rgba(251, 191, 36, 0.85);
      color: #0b0f19;
      font-size: 1.45rem;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      box-shadow: 0 8px 30px rgba(245, 158, 11, 0.45), 0 0 22px rgba(245, 158, 11, 0.3);
      z-index: 99990;
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .voice-guide-fab:hover {
      transform: scale(1.1) translateY(-2px);
      box-shadow: 0 12px 38px rgba(245, 158, 11, 0.7), 0 0 30px rgba(245, 158, 11, 0.45);
      color: #000;
    }
    .voice-guide-fab:active { transform: scale(0.94); }
    .voice-guide-fab span { display: none !important; }

    /* ── NO SUBWINDOW BACKDROP: 3D Scene Remains Fully Visible & Interactive ── */
    .vg-backdrop {
      display: none !important;
      pointer-events: none !important;
    }

    /* ── Docked on Corner of Right Side in Middle Position ────────────────── */
    .vg-panel {
      position: fixed;
      top: 50%;
      right: 24px;
      transform: translateY(-50%) translateX(calc(100% + 40px));
      width: min(90vw, 420px);
      max-height: 86vh;
      z-index: 99999;
      opacity: 0;
      pointer-events: none;
      transition: transform 0.38s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease;
    }
    .vg-panel.open {
      transform: translateY(-50%) translateX(0);
      opacity: 1;
      pointer-events: auto;
    }

    .vg-panel-inner {
      background: rgba(8, 12, 26, 0.96);
      backdrop-filter: blur(28px);
      -webkit-backdrop-filter: blur(28px);
      border: 1px solid rgba(245, 158, 11, 0.5);
      border-radius: 22px;
      padding: 20px 22px;
      box-shadow: 0 24px 60px rgba(0, 0, 0, 0.85), 0 0 30px rgba(245, 158, 11, 0.2);
      color: #f8fafc;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      display: flex;
      flex-direction: column;
      max-height: 86vh;
    }

    .vg-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 12px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      padding-bottom: 10px;
    }
    .vg-header-left {
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .vg-icon-badge {
      width: 38px;
      height: 38px;
      border-radius: 10px;
      background: linear-gradient(135deg, rgba(245, 158, 11, 0.3), rgba(217, 119, 6, 0.15));
      border: 1px solid rgba(245, 158, 11, 0.55);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.2rem;
      box-shadow: 0 0 12px rgba(245, 158, 11, 0.2);
    }
    .vg-title-group h3 {
      margin: 0;
      font-size: 1.02rem;
      font-weight: 700;
      color: #fbbf24;
      letter-spacing: -0.01em;
    }
    .vg-title-group p {
      margin: 2px 0 0 0;
      font-size: 0.72rem;
      color: #94a3b8;
    }
    .vg-header-right {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    /* ── Themed HUD Toggle Button (Royal Gold Pill) ── */
    .vg-hud-toggle-btn {
      background: rgba(245, 158, 11, 0.14);
      border: 1px solid rgba(245, 158, 11, 0.5);
      color: #fbbf24;
      border-radius: 20px;
      padding: 5px 12px;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.02em;
      cursor: pointer;
      transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
      display: inline-flex;
      align-items: center;
      gap: 5px;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
    }
    .vg-hud-toggle-btn:hover {
      background: rgba(245, 158, 11, 0.28);
      border-color: #fbbf24;
      color: #fff;
      box-shadow: 0 0 14px rgba(245, 158, 11, 0.4);
      transform: translateY(-1px);
    }
    .vg-hud-toggle-btn.active {
      background: linear-gradient(135deg, #f59e0b, #d97706);
      border-color: #fde68a;
      color: #0b0f19;
      font-weight: 800;
      box-shadow: 0 0 16px rgba(245, 158, 11, 0.5);
    }

    /* ── Themed Close Button ── */
    .vg-close-btn {
      background: rgba(245, 158, 11, 0.12);
      border: 1px solid rgba(245, 158, 11, 0.4);
      color: #fbbf24;
      border-radius: 50%;
      width: 32px;
      height: 32px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      font-size: 0.92rem;
      font-weight: 700;
      transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
    }
    .vg-close-btn:hover {
      background: rgba(239, 68, 68, 0.3);
      border-color: #ef4444;
      color: #ffffff;
      transform: rotate(90deg) scale(1.1);
      box-shadow: 0 0 14px rgba(239, 68, 68, 0.5);
    }

    /* ── Language Row ── */
    .vg-lang-row {
      display: flex;
      gap: 6px;
      overflow-x: auto;
      padding-bottom: 8px;
      margin-bottom: 10px;
      scrollbar-width: thin;
      flex-shrink: 0;
    }
    .vg-lang-row::-webkit-scrollbar { height: 4px; }
    .vg-lang-row::-webkit-scrollbar-thumb { background: rgba(245, 158, 11, 0.4); border-radius: 2px; }
    .vg-lang-pill {
      flex-shrink: 0;
      padding: 5px 11px;
      border-radius: 20px;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.12);
      color: #cbd5e1;
      font-size: 0.74rem;
      font-weight: 600;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 4px;
      transition: all 0.2s;
    }
    .vg-lang-pill:hover { background: rgba(245, 158, 11, 0.18); border-color: rgba(245, 158, 11, 0.45); color: #fff; }
    .vg-lang-pill.active {
      background: linear-gradient(135deg, #f59e0b, #d97706);
      border-color: #fbbf24;
      color: #0b0f19;
      font-weight: 800;
      box-shadow: 0 0 14px rgba(245, 158, 11, 0.4);
    }

    /* ── Prominent, Crisp, High-Contrast Script Box ── */
    .vg-script-box {
      flex: 1;
      min-height: 180px;
      max-height: 290px;
      overflow-y: auto;
      background: rgba(4, 7, 18, 0.92);
      border: 1px solid rgba(245, 158, 11, 0.4);
      border-radius: 14px;
      padding: 16px 18px;
      font-size: 0.92rem;
      line-height: 1.75;
      color: #f1f5f9;
      margin-bottom: 12px;
      scrollbar-width: thin;
      box-shadow: inset 0 2px 8px rgba(0, 0, 0, 0.6);
      user-select: text;
    }
    .vg-script-box::-webkit-scrollbar { width: 5px; }
    .vg-script-box::-webkit-scrollbar-thumb { background: rgba(245, 158, 11, 0.4); border-radius: 3px; }
    .vg-word {
      display: inline;
      color: #e2e8f0;
      transition: color 0.12s ease, background-color 0.12s ease;
      cursor: pointer;
      border-radius: 3px;
      padding: 1px 2px;
    }
    .vg-word:hover { background: rgba(245, 158, 11, 0.2); }
    .vg-word.vg-word-active {
      color: #0b0f19 !important;
      background: #fbbf24 !important;
      font-weight: 800 !important;
      box-shadow: 0 0 12px rgba(245, 158, 11, 0.85);
    }
    .vg-word.vg-word-spoken { color: #ffd56b; opacity: 0.92; }

    /* ── Controls ── */
    .vg-controls {
      display: flex;
      gap: 8px;
      margin-bottom: 10px;
      flex-shrink: 0;
    }
    .vg-btn {
      flex: 1;
      padding: 9px 14px;
      border-radius: 12px;
      font-size: 0.85rem;
      font-weight: 700;
      cursor: pointer;
      border: none;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 7px;
      transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .vg-play {
      background: linear-gradient(135deg, #f59e0b, #d97706);
      color: #0b0f19;
      box-shadow: 0 4px 16px rgba(245, 158, 11, 0.35);
    }
    .vg-play:hover { transform: translateY(-1px); box-shadow: 0 6px 20px rgba(245, 158, 11, 0.5); }
    .vg-play.playing {
      background: linear-gradient(135deg, #0284c7, #0369a1);
      color: #ffffff;
      box-shadow: 0 4px 16px rgba(2, 132, 199, 0.4);
    }
    .vg-stop {
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(255, 255, 255, 0.12);
      color: #94a3b8;
    }
    .vg-stop:hover:not(:disabled) { background: rgba(239, 68, 68, 0.2); color: #f87171; border-color: rgba(239, 68, 68, 0.4); }
    .vg-stop:disabled { opacity: 0.4; cursor: not-allowed; }

    /* ── Progress Bar ── */
    .vg-progress-wrap {
      width: 100%;
      height: 4px;
      background: rgba(255, 255, 255, 0.08);
      border-radius: 2px;
      overflow: hidden;
      margin-bottom: 10px;
      flex-shrink: 0;
    }
    .vg-progress-bar {
      height: 100%;
      width: 0%;
      background: linear-gradient(90deg, #f59e0b, #fbbf24);
      transition: width 0.15s ease;
      box-shadow: 0 0 8px rgba(245, 158, 11, 0.6);
    }

    /* ── Distinct Speed Timeline (Audibly Changes English & All Voices) ── */
    .vg-bottom-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      flex-wrap: wrap;
      flex-shrink: 0;
    }
    .vg-rate-row {
      display: flex;
      align-items: center;
      gap: 4px;
    }
    .vg-rate-row span {
      font-size: 0.72rem;
      color: #94a3b8;
      font-weight: 600;
      margin-right: 2px;
    }
    .vg-rate-btn {
      padding: 3px 8px;
      border-radius: 6px;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.1);
      color: #94a3b8;
      font-size: 0.72rem;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.18s;
    }
    .vg-rate-btn:hover { color: #fff; border-color: rgba(245, 158, 11, 0.4); }
    .vg-rate-btn.active {
      background: rgba(245, 158, 11, 0.25);
      border-color: #fbbf24;
      color: #fbbf24;
      font-weight: 800;
    }
    .vg-voice-info {
      font-size: 0.72rem;
      color: #94a3b8;
      text-align: right;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      flex: 1;
    }

    /* ── Themed Floating Cinema Subtitle HUD on 3D Viewport ── */
    .vg-subtitle-hud {
      position: fixed;
      bottom: 30px;
      left: 50%;
      transform: translateX(-50%);
      width: min(88vw, 680px);
      background: rgba(6, 10, 24, 0.94);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1.5px solid rgba(245, 158, 11, 0.5);
      border-radius: 18px;
      padding: 12px 18px;
      box-shadow: 0 16px 40px rgba(0, 0, 0, 0.8), 0 0 24px rgba(245, 158, 11, 0.25);
      z-index: 100000;
      pointer-events: auto;
      font-family: system-ui, -apple-system, sans-serif;
      transition: all 0.25s ease;
    }
    .vg-hud-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 6px;
      padding-bottom: 6px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }
    .vg-hud-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: rgba(245, 158, 11, 0.18);
      border: 1px solid rgba(245, 158, 11, 0.45);
      border-radius: 20px;
      padding: 2px 10px;
      font-size: 0.68rem;
      font-weight: 800;
      color: #fbbf24;
      letter-spacing: 0.05em;
      text-transform: uppercase;
    }
    .vg-hud-dot {
      width: 6px;
      height: 6px;
      background: #fbbf24;
      border-radius: 50%;
      box-shadow: 0 0 8px #fbbf24;
      animation: vgDotPulse 1.2s infinite alternate;
    }
    @keyframes vgDotPulse {
      0% { opacity: 0.4; transform: scale(0.8); }
      100% { opacity: 1; transform: scale(1.2); }
    }
    .vg-hud-title {
      font-size: 0.76rem;
      color: #94a3b8;
      font-weight: 600;
    }
    .vg-hud-close {
      background: rgba(245, 158, 11, 0.15);
      border: 1px solid rgba(245, 158, 11, 0.4);
      color: #fbbf24;
      border-radius: 50%;
      width: 26px;
      height: 26px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 0.8rem;
      cursor: pointer;
      transition: all 0.2s ease;
    }
    .vg-hud-close:hover {
      color: #fff;
      background: rgba(239, 68, 68, 0.35);
      border-color: #ef4444;
      transform: rotate(90deg);
    }
    .vg-hud-content {
      font-size: clamp(0.9rem, 1.6vw, 1.05rem);
      line-height: 1.55;
      text-align: center;
      color: #e2e8f0;
      min-height: 2.6em;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-wrap: wrap;
    }
    .vg-hud-content .vg-hud-word {
      display: inline;
      transition: color 0.12s ease, text-shadow 0.12s ease;
      padding: 0 2px;
    }
    .vg-hud-content .vg-hud-word.active {
      color: #ffd56b;
      font-weight: 800;
      text-shadow: 0 0 14px rgba(251, 191, 36, 0.8), 0 0 24px rgba(245, 158, 11, 0.4);
    }
    .vg-hud-content .vg-hud-word.spoken { color: #ffffff; opacity: 0.95; }
    .vg-hud-content .vg-hud-word.pending { color: #64748b; opacity: 0.55; }

    @media (max-width: 640px) {
      .vg-panel {
        right: 12px;
        width: calc(100vw - 24px);
        max-height: 82vh;
      }
      .voice-guide-fab {
        bottom: 20px;
        right: 20px;
        width: 52px;
        height: 52px;
        font-size: 1.25rem;
      }
      .vg-subtitle-hud {
        width: calc(100vw - 28px);
        bottom: 84px;
      }
    }

  </style>
</head>
<body>

<div id="loading"><div class="glyph"></div><span>Raising the gopuram…</span></div>

<div id="canvas-wrap"></div>

<div id="hero" style="display:flex; justify-content:space-between; align-items:flex-start; z-index:90;">
  <div>
    <h1>Lepakshi · Veerabhadra Temple</h1>
    <p>Vijayanagara stonework · Anantapur, Andhra Pradesh · c. 1530 CE</p>
    <div class="heritage-provenance" style="margin-top:10px; padding:8px 12px; background:rgba(201,154,61,0.16); border:1px solid rgba(201,154,61,0.45); border-radius:8px; display:flex; flex-direction:column; gap:5px; font-size:11px; max-width:480px; pointer-events:auto; backdrop-filter:blur(10px);">
      <div style="display:flex; justify-content:space-between; gap:10px; align-items:baseline;">
        <span style="color:#d9c7a8; font-size:9px; text-transform:uppercase; letter-spacing:0.8px; font-weight:700;"><i class="fa-solid fa-monument" style="color:var(--gold);"></i> BUILT FOR:</span>
        <strong style="color:#ffd56b; text-align:right;">Lord Veerabhadra (Shiva) (Commissioned by Virupanna &amp; Viranna)</strong>
      </div>
      <div style="display:flex; justify-content:space-between; gap:10px; align-items:baseline;">
        <span style="color:#d9c7a8; font-size:9px; text-transform:uppercase; letter-spacing:0.8px; font-weight:700;"><i class="fa-solid fa-location-dot" style="color:var(--gold);"></i> PICKED FROM:</span>
        <span style="color:#f4ead9; text-align:right;">Lepakshi, Sri Sathya Sai District, Andhra Pradesh</span>
      </div>
    </div>
  </div>
  <div style="display:flex; gap:10px; align-items:center;">
<a href="index.html" style="pointer-events:auto; font-size:11px; text-decoration:none; background:rgba(201,154,61,0.18); color:var(--gold); border:1px solid rgba(201,154,61,0.45); padding:7px 14px; border-radius:6px; font-weight:600; letter-spacing:0.05em; white-space:nowrap;">🌐 3D GLOBE</a>
  </div>
</div>

<div id="controls-hint">Drag to orbit · Scroll / pinch to zoom<br/>Tap a gold marker for its story</div>

<div id="hotspots"></div>

<div id="panel">
  <button class="close" onclick="closePanel()">✕</button>
  <p class="eyebrow" id="p-eyebrow">Landmark</p>
  <h2 id="p-title">—</h2>
  <p id="p-body">—</p>
  <button class="action" id="p-action" style="display:none;"></button>
</div>


  


  <div id="legend">Stylized interactive model — proportions and layout follow the temple's real features, not laser-scan data. Best explored slowly, the way the mandapa itself asks you to.</div>

<div id="vr-btn-wrap"></div>

<script type="importmap">
{
  "imports": {
    "three": "https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js",
    "three/addons/": "https://cdn.jsdelivr.net/npm/three@0.160.0/examples/jsm/"
  }
}
</script>

<script type="module">
import * as THREE from 'three';
import { OrbitControls } from 'three/addons/controls/OrbitControls.js';
import { VRButton } from 'three/addons/webxr/VRButton.js';

const wrap = document.getElementById('canvas-wrap');
const hotspotLayer = document.getElementById('hotspots');

// ---------- renderer / scene / camera ----------
const renderer = new THREE.WebGLRenderer({ antialias:true, powerPreference:'high-performance' });
renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
renderer.setSize(window.innerWidth, window.innerHeight);
renderer.shadowMap.enabled = true;
renderer.shadowMap.type = THREE.PCFSoftShadowMap;
renderer.xr.enabled = true;
renderer.outputColorSpace = THREE.SRGBColorSpace;
wrap.appendChild(renderer.domElement);
document.getElementById('vr-btn-wrap').appendChild(VRButton.createButton(renderer));

const scene = new THREE.Scene();

// sky gradient
const skyCanvas = document.createElement('canvas');
skyCanvas.width = 8; skyCanvas.height = 256;
const skyCtx = skyCanvas.getContext('2d');
const grad = skyCtx.createLinearGradient(0,0,0,256);
grad.addColorStop(0, '#1c2440');
grad.addColorStop(0.42, '#4a5c86');
grad.addColorStop(0.72, '#d9925f');
grad.addColorStop(1, '#f2c887');
skyCtx.fillStyle = grad;
skyCtx.fillRect(0,0,8,256);
const skyTex = new THREE.CanvasTexture(skyCanvas);
skyTex.colorSpace = THREE.SRGBColorSpace;
scene.background = skyTex;
scene.fog = new THREE.FogExp2(0x8a7a6a, 0.010);

const camera = new THREE.PerspectiveCamera(50, window.innerWidth/window.innerHeight, 0.1, 500);
camera.position.set(21, 11, 24);

const controls = new OrbitControls(camera, renderer.domElement);
controls.target.set(0, 3, 0);
controls.enableDamping = true;
controls.dampingFactor = 0.08;
controls.minDistance = 6;
controls.maxDistance = 55;
controls.maxPolarAngle = Math.PI * 0.49;

// ---------- lights ----------
const sun = new THREE.DirectionalLight(0xffe3b0, 2.4);
sun.position.set(20, 26, 10);
sun.castShadow = true;
sun.shadow.mapSize.set(2048,2048);
sun.shadow.camera.left = -30; sun.shadow.camera.right = 30;
sun.shadow.camera.top = 30; sun.shadow.camera.bottom = -30;
sun.shadow.bias = -0.0015;
scene.add(sun);
scene.add(new THREE.HemisphereLight(0xd9c9a8, 0x4a3d2c, 0.9));
scene.add(new THREE.AmbientLight(0xffffff, 0.25));

const warmFill = new THREE.PointLight(0xffb35c, 40, 22);
warmFill.position.set(-4, 6, 6);
scene.add(warmFill);

// ---------- materials ----------
const granite = new THREE.MeshStandardMaterial({ color:0x8a7d68, roughness:0.92, metalness:0.03 });
const graniteDark = new THREE.MeshStandardMaterial({ color:0x4d4335, roughness:0.95, metalness:0.02 });
const graniteWeathered = new THREE.MeshStandardMaterial({ color:0x6d6250, roughness:0.9, metalness:0.02 });
const ochreStone = new THREE.MeshStandardMaterial({ color:0xa8552b, roughness:0.85, metalness:0.05 });
const gold = new THREE.MeshStandardMaterial({ color:0xc99a3d, roughness:0.35, metalness:0.75 });
const maroon = new THREE.MeshStandardMaterial({ color:0x5e1f1c, roughness:0.7, metalness:0.1 });
const nandiStone = new THREE.MeshStandardMaterial({ color:0x362c22, roughness:0.75, metalness:0.08 });

// ---------- ground: tortoise-shaped rock mound ----------
const groundGeo = new THREE.CircleGeometry(34, 96);
groundGeo.rotateX(-Math.PI/2);
const posAttr = groundGeo.attributes.position;
for(let i=0;i<posAttr.count;i++){
  const x = posAttr.getX(i), z = posAttr.getZ(i);
  const r = Math.sqrt(x*x+z*z);
  const bump = Math.sin(x*0.35)*Math.cos(z*0.3)*0.35 + Math.sin(r*0.5)*0.15;
  posAttr.setY(i, bump - r*0.012);
}
groundGeo.computeVertexNormals();
const ground = new THREE.Mesh(groundGeo, graniteWeathered);
ground.receiveShadow = true;
scene.add(ground);

// low compound wall
const wallGroup = new THREE.Group();
const wallRadius = 15.5;
const wallSegs = 4; // simplified rectangular-ish enclosure via 4 straight runs
function addWallRun(x1,z1,x2,z2){
  const len = Math.hypot(x2-x1, z2-z1);
  const wall = new THREE.Mesh(new THREE.BoxGeometry(len, 1.1, 0.5), graniteWeathered);
  wall.position.set((x1+x2)/2, 0.55, (z1+z2)/2);
  wall.rotation.y = Math.atan2(z2-z1, x2-x1);
  wall.castShadow = true; wall.receiveShadow = true;
  wallGroup.add(wall);
}
addWallRun(-15,-15, 15,-15);
addWallRun(15,-15, 15,15);
addWallRun(15,15, -15,15);
addWallRun(-15,15, -15,-15);
scene.add(wallGroup);

// ---------- fresco-style ceiling panel (canvas texture) ----------
function makeFrescoTexture(){
  const c = document.createElement('canvas'); c.width=512; c.height=512;
  const ctx = c.getContext('2d');
  ctx.fillStyle = '#c9a86a'; ctx.fillRect(0,0,512,512);
  ctx.strokeStyle = '#5e1f1c'; ctx.lineWidth = 10;
  ctx.strokeRect(14,14,484,484);
  // stylized central deity silhouette (fiery Veerabhadra motif — abstracted)
  ctx.save();
  ctx.translate(256,256);
  ctx.fillStyle = '#8a2c1f';
  ctx.beginPath();
  for(let i=0;i<12;i++){
    const ang = (i/12)*Math.PI*2;
    const rad = i%2===0 ? 150 : 90;
    ctx.lineTo(Math.cos(ang)*rad, Math.sin(ang)*rad);
  }
  ctx.closePath(); ctx.fill();
  ctx.fillStyle = '#c99a3d';
  ctx.beginPath(); ctx.arc(0,0,55,0,Math.PI*2); ctx.fill();
  ctx.fillStyle = '#20180f';
  ctx.beginPath(); ctx.arc(-16,-8,7,0,Math.PI*2); ctx.arc(16,-8,7,0,Math.PI*2); ctx.fill();
  ctx.restore();
  // border dots (fresco border pattern)
  ctx.fillStyle = '#2f5a4a';
  for(let i=0;i<28;i++){
    const t = i/28*Math.PI*2;
    ctx.beginPath();
    ctx.arc(256+Math.cos(t)*220, 256+Math.sin(t)*220, 6, 0, Math.PI*2);
    ctx.fill();
  }
  const tex = new THREE.CanvasTexture(c);
  tex.colorSpace = THREE.SRGBColorSpace;
  return tex;
}
const frescoMat = new THREE.MeshStandardMaterial({ map: makeFrescoTexture(), roughness:0.85 });

// ---------- pillared mandapa hall ----------
const mandapa = new THREE.Group();

function makePillar(height=3.6){
  const g = new THREE.Group();
  const shaft = new THREE.Mesh(new THREE.CylinderGeometry(0.24,0.28,height,10), granite);
  shaft.position.y = height/2;
  shaft.castShadow = true; shaft.receiveShadow = true;
  g.add(shaft);
  const base = new THREE.Mesh(new THREE.CylinderGeometry(0.38,0.42,0.25,10), graniteDark);
  base.position.y = 0.12;
  base.castShadow = true;
  g.add(base);
  const capital = new THREE.Mesh(new THREE.CylinderGeometry(0.4,0.28,0.3,10), ochreStone);
  capital.position.y = height - 0.1;
  capital.castShadow = true;
  g.add(capital);
  const abacus = new THREE.Mesh(new THREE.BoxGeometry(0.8,0.16,0.8), graniteDark);
  abacus.position.y = height + 0.08;
  abacus.castShadow = true;
  g.add(abacus);
  return g;
}

const pillarH = 3.6;
const cols = 6, rows = 5, spacing = 2.05;
let hangingPillarRef = null;
for(let i=0;i<cols;i++){
  for(let j=0;j<rows;j++){
    const p = makePillar(pillarH);
    const x = (i-(cols-1)/2)*spacing;
    const z = (j-(rows-1)/2)*spacing - 3;
    p.position.set(x, 0, z);
    // the famous hanging pillar: one column lifted slightly off the ground
    if(i===2 && j===2){
      p.position.y = 0.14; // visible gap under the base
      hangingPillarRef = p;
    }
    mandapa.add(p);
  }
}

// roof / lintel slab
const roof = new THREE.Mesh(new THREE.BoxGeometry(cols*spacing+1, 0.35, rows*spacing+1), graniteDark);
roof.position.set(0, pillarH+0.35, -3);
roof.castShadow = true; roof.receiveShadow = true;
mandapa.add(roof);

// fresco ceiling panel set into the roof underside
const fresco = new THREE.Mesh(new THREE.PlaneGeometry(3.4,3.4), frescoMat);
fresco.rotation.x = Math.PI/2;
fresco.position.set(0, pillarH+0.16, -3);
mandapa.add(fresco);

// mandapa floor platform
const platform = new THREE.Mesh(new THREE.BoxGeometry(cols*spacing+2, 0.6, rows*spacing+2), granite);
platform.position.set(0, -0.3, -3);
platform.receiveShadow = true; platform.castShadow = true;
mandapa.add(platform);

scene.add(mandapa);

// gold ring highlight under hanging pillar
const ringGeo = new THREE.TorusGeometry(0.5, 0.03, 12, 32);
const ring = new THREE.Mesh(ringGeo, gold);
ring.rotation.x = Math.PI/2;
ring.position.set(hangingPillarRef.position.x, 0.02, hangingPillarRef.position.z);
scene.add(ring);

// thin "cloth" strip for the hanging-pillar demo animation
const clothMat = new THREE.MeshStandardMaterial({ color:0xf4ead9, roughness:0.6, side:THREE.DoubleSide });
const cloth = new THREE.Mesh(new THREE.PlaneGeometry(1.6,0.35), clothMat);
cloth.rotation.x = -Math.PI/2;
cloth.position.set(hangingPillarRef.position.x - 3, 0.07, hangingPillarRef.position.z);
cloth.visible = false;
scene.add(cloth);
let clothAnim = null;
window.testHangingPillar = function(){
  cloth.visible = true;
  cloth.position.x = hangingPillarRef.position.x - 3;
  const targetX = hangingPillarRef.position.x + 3;
  const start = performance.now();
  const dur = 2200;
  function step(now){
    const t = Math.min((now-start)/dur, 1);
    cloth.position.x = THREE.MathUtils.lerp(hangingPillarRef.position.x - 3, targetX, t);
    if(t<1) clothAnim = requestAnimationFrame(step);
    else setTimeout(()=>{cloth.visible=false;}, 500);
  }
  if(clothAnim) cancelAnimationFrame(clothAnim);
  clothAnim = requestAnimationFrame(step);
};

// ---------- gopuram (stepped entrance tower) ----------
const gopuram = new THREE.Group();
const tiers = 6;
let tierY = 0;
for(let t=0; t<tiers; t++){
  const w = 5.2 - t*0.65;
  const h = 1.15;
  const mat = t%2===0 ? ochreStone : granite;
  const tier = new THREE.Mesh(new THREE.BoxGeometry(w, h, w*0.85), mat);
  tier.position.y = tierY + h/2;
  tier.castShadow = true; tier.receiveShadow = true;
  gopuram.add(tier);
  // corner finials per tier
  if(t < tiers-1){
    [[1,1],[1,-1],[-1,1],[-1,-1]].forEach(([sx,sz])=>{
      const fin = new THREE.Mesh(new THREE.ConeGeometry(0.16,0.4,6), gold);
      fin.position.set(sx*(w/2-0.25), tierY+h+0.15, sz*(w*0.85/2-0.25));
      fin.castShadow = true;
      gopuram.add(fin);
    });
  }
  tierY += h;
}
const kalasha = new THREE.Mesh(new THREE.SphereGeometry(0.3,12,10), gold);
kalasha.position.y = tierY + 0.3;
kalasha.castShadow = true;
gopuram.add(kalasha);
const kalashaTip = new THREE.Mesh(new THREE.ConeGeometry(0.14,0.5,8), gold);
kalashaTip.position.y = tierY + 0.75;
gopuram.add(kalashaTip);
// gateway opening
const gateFrame = new THREE.Mesh(new THREE.BoxGeometry(1.6,2.4,0.9), graniteDark);
gateFrame.position.set(0, 1.2, 0.1);
gateFrame.castShadow = true;
gopuram.add(gateFrame);
gopuram.position.set(0, 0, 10.5);
scene.add(gopuram);

// ---------- monolithic Nandi ----------
const nandi = new THREE.Group();
const body = new THREE.Mesh(new THREE.CapsuleGeometry(0.85,1.7,6,10), nandiStone);
body.rotation.z = Math.PI/2;
body.position.set(0,1.1,0);
body.castShadow = true; body.receiveShadow = true;
nandi.add(body);
const head = new THREE.Mesh(new THREE.BoxGeometry(0.85,0.8,0.7), nandiStone);
head.position.set(1.35,1.35,0);
head.castShadow = true;
nandi.add(head);
[[-0.18,0.35],[0.18,0.35]].forEach(([ox,oy])=>{
  const horn = new THREE.Mesh(new THREE.ConeGeometry(0.1,0.5,8), nandiStone);
  horn.position.set(1.55, 1.85+ (oy-0.35)*0, ox);
  horn.rotation.z = Math.PI*0.12;
  horn.castShadow = true;
  nandi.add(horn);
});
const legPositions = [[0.7,0.55],[0.7,-0.55],[-0.7,0.55],[-0.7,-0.55]];
legPositions.forEach(([lx,lz])=>{
  const leg = new THREE.Mesh(new THREE.CylinderGeometry(0.19,0.16,1.05,8), nandiStone);
  leg.position.set(lx,0.5,lz);
  leg.castShadow = true; leg.receiveShadow = true;
  nandi.add(leg);
});
const necklace = new THREE.Mesh(new THREE.TorusGeometry(0.5,0.06,8,20), gold);
necklace.position.set(1.05,1.15,0);
necklace.rotation.y = Math.PI/2;
nandi.add(necklace);
const pedestal = new THREE.Mesh(new THREE.BoxGeometry(3.4,0.4,2.1), graniteDark);
pedestal.position.set(0.3,-0.05,0);
pedestal.receiveShadow = true; pedestal.castShadow = true;
nandi.add(pedestal);
nandi.scale.set(1.55,1.55,1.55);
nandi.position.set(0,0.35,16.5);
nandi.rotation.y = Math.PI;
scene.add(nandi);

// ---------- Nagalinga (coiled serpent over shivalinga) ----------
const naga = new THREE.Group();
const coilCurve = new THREE.CatmullRomCurve3(
  Array.from({length:9},(_,i)=>{
    const t = i/8;
    return new THREE.Vector3(Math.sin(t*Math.PI*3)*0.55*(1-t*0.4), t*1.9, Math.cos(t*Math.PI*3)*0.55*(1-t*0.4));
  })
);
const coilGeo = new THREE.TubeGeometry(coilCurve, 64, 0.16, 8, false);
const coilMesh = new THREE.Mesh(coilGeo, graniteDark);
coilMesh.castShadow = true;
naga.add(coilMesh);
// fanned hoods at the top
for(let i=0;i<7;i++){
  const hood = new THREE.Mesh(new THREE.ConeGeometry(0.16,0.55,6), graniteDark);
  const ang = (i-3)*0.26;
  hood.position.set(Math.sin(ang)*0.35, 2.05+Math.cos(ang)*0.25, 0);
  hood.rotation.z = -ang;
  hood.castShadow = true;
  naga.add(hood);
}
const linga = new THREE.Mesh(new THREE.CylinderGeometry(0.22,0.24,0.9,12), graniteWeathered);
linga.position.y = 0.45;
linga.castShadow = true; linga.receiveShadow = true;
naga.add(linga);
const lingaBase = new THREE.Mesh(new THREE.CylinderGeometry(0.55,0.6,0.25,16), graniteDark);
lingaBase.position.y = -0.02;
lingaBase.castShadow = true; lingaBase.receiveShadow = true;
naga.add(lingaBase);
naga.position.set(-9.5, 0, 5);
scene.add(naga);

document.getElementById('loading').style.opacity = '0';
setTimeout(()=>{document.getElementById('loading').style.display='none';}, 650);

// ---------- hotspots ----------
const hotspotData = [
  {
    obj: hangingPillarRef, offset:new THREE.Vector3(0,3.9,0),
    eyebrow:'The Wonder', title:'The Hanging Pillar',
    body:'One of the 70 carved pillars of the Kalyana Mandapa never quite reaches the floor — a thin gap runs beneath its base. Visitors have passed cloth clean under it for centuries; the engineering behind it is still debated.',
    action:'Test the pillar', onAction:()=>window.testHangingPillar()
  },
  {
    obj: nandi, offset:new THREE.Vector3(0,2.1,0),
    eyebrow:'Monolithic Sculpture', title:'The Great Nandi',
    body:"Carved from a single granite boulder, this Nandi — Shiva's bull — is among the largest of its kind in India, roughly 15 feet tall and 27 feet long, facing the sanctum in eternal watch.",
    action:'', onAction:null
  },
  {
    obj: gopuram, offset:new THREE.Vector3(0,7.5,0),
    eyebrow:'Entrance Tower', title:'The Gopuram',
    body:'A stepped pyramidal tower in classic Vijayanagara form, tier upon tier narrowing toward a gilded kalasha finial — the threshold between the everyday village and consecrated ground.',
    action:'', onAction:null
  },
  {
    obj: naga, offset:new THREE.Vector3(0,2.3,0),
    eyebrow:'Legend in Stone', title:'The Nagalinga',
    body:"Said to have been carved in a single hour by craftsmen waiting for their midday meal: a seven-hooded serpent coiled protectively over a Shivalinga, sheltering it like a living canopy.",
    action:'', onAction:null
  },
  {
    obj: mandapa, offset:new THREE.Vector3(0,pillarH+0.7,-3),
    eyebrow:'Ceiling Art', title:'Frescoed Ceilings',
    body:'Above the mandapa, painted panels once covered in mineral-pigment murals depict scenes from the Ramayana, Mahabharata and Puranas — including a fresco of Veerabhadra ranked among the largest single-figure paintings in India.',
    action:'', onAction:null
  },
];

const hotspotEls = hotspotData.map((d)=>{
  const el = document.createElement('div');
  el.className = 'hotspot';
  el.addEventListener('click', ()=>openPanel(d));
  hotspotLayer.appendChild(el);
  return el;
});

const panelEl = document.getElementById('panel');
function openPanel(d){
  document.getElementById('p-eyebrow').textContent = d.eyebrow;
  document.getElementById('p-title').textContent = d.title;
  document.getElementById('p-body').textContent = d.body;
  const btn = document.getElementById('p-action');
  if(d.action){
    btn.style.display='inline-block';
    btn.textContent = d.action;
    btn.onclick = d.onAction;
  } else {
    btn.style.display='none';
  }
  panelEl.classList.add('open');
}
window.closePanel = function(){ panelEl.classList.remove('open'); };

const tmpV = new THREE.Vector3();
function updateHotspots(){
  hotspotData.forEach((d,i)=>{
    d.obj.getWorldPosition(tmpV);
    tmpV.add(d.offset);
    const proj = tmpV.clone().project(camera);
    const el = hotspotEls[i];
    if(proj.z > 1){ el.style.display='none'; return; }
    const x = (proj.x*0.5+0.5)*window.innerWidth;
    const y = (-proj.y*0.5+0.5)*window.innerHeight;
    el.style.display='block';
    el.style.transform = `translate(${x}px, ${y}px)`;
  });
}

// ---------- resize ----------
window.addEventListener('resize', ()=>{
  camera.aspect = window.innerWidth/window.innerHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(window.innerWidth, window.innerHeight);
});

// ---------- render loop ----------
renderer.setAnimationLoop(()=>{
  controls.update();
  warmFill.intensity = 36 + Math.sin(performance.now()*0.0006)*6;
  renderer.render(scene, camera);
  updateHotspots();
});
</script>

  
  


  


  


  
  

  
  

  
  
  </div>

  
  

  


  
  

  
  
  </div>

  
  

  


  </div>

  
  </div>

  
  </div>

  
  </div>

  
  </div>

  
  <!-- ══ VOICE GUIDE TRIGGER (ICON-ONLY MICROPHONE, SAME POSITION) ══ -->
  <button id="btn-voice-guide" class="voice-guide-fab" title="Heritage Voice Guide" aria-label="Heritage Voice Guide">
    <i class="fa-solid fa-microphone-lines"></i>
  </button>

  <!-- ══ MULTILINGUAL VOICE GUIDE (DOCKED RIGHT-SIDE MIDDLE POSITION) ══ -->
  <div id="voice-guide-panel" class="vg-panel" role="dialog" aria-label="Heritage Voice Guide">
    <div class="vg-panel-inner">
      <div class="vg-header">
        <div class="vg-header-left">
          <div class="vg-icon-badge">🎧</div>
          <div class="vg-title-group">
            <h3>Lepakshi Veerabhadra Temple · Audio Guide</h3>
            <p>500+ Word Scholarly Narrative &amp; Subtitle Tracker</p>
          </div>
        </div>
        <div class="vg-header-right">
          <button type="button" class="vg-hud-toggle-btn active" id="vg-hud-toggle" title="Toggle Live Subtitle HUD">
            <i class="fa-solid fa-closed-captioning"></i> HUD: ON
          </button>
          <button type="button" class="vg-close-btn" id="vg-close" aria-label="Close Voice Guide">✕</button>
        </div>
      </div>

      <!-- Language selector pills -->
      <div class="vg-lang-row" id="vg-lang-row"></div>

      <!-- Script Box with Subtitle Tracker -->
      <div class="vg-script-box" id="vg-script-box" aria-live="polite"></div>

      <!-- Audio Controls -->
      <div class="vg-controls">
        <button class="vg-btn vg-play" id="vg-play">
          <span id="vg-play-icon">▶</span>
          <span id="vg-play-label">Play Audio Guide</span>
        </button>
        <button class="vg-btn vg-stop" id="vg-stop" disabled>
          <span>⏹ Stop</span>
        </button>
      </div>

      <!-- Progress Bar -->
      <div class="vg-progress-wrap">
        <div class="vg-progress-bar" id="vg-progress-bar"></div>
      </div>

      <!-- Speed Timeline (Noticeable Auditory Rates for English & All Languages) -->
      <div class="vg-bottom-row">
        <div class="vg-rate-row">
          <span>Speed:</span>
          <button class="vg-rate-btn" data-rate="0.75">0.75x</button>
          <button class="vg-rate-btn active" data-rate="1.0">1.0x</button>
          <button class="vg-rate-btn" data-rate="1.25">1.25x</button>
          <button class="vg-rate-btn" data-rate="1.5">1.5x</button>
          <button class="vg-rate-btn" data-rate="1.75">1.75x</button>
        </div>
        <div class="vg-voice-info" id="vg-voice-info">🔊 Voice Ready</div>
      </div>
    </div>
  </div>

  <!-- ══ THEMED FLOATING CINEMA SUBTITLE HUD ON 3D VIEWPORT ══ -->
  <div id="vg-subtitle-hud" class="vg-subtitle-hud" style="display:none;" aria-live="polite">
    <div class="vg-hud-header">
      <div class="vg-hud-badge">
        <span class="vg-hud-dot"></span>
