# YUGMA Platform Environment Configuration Template
# Copy this file to .env for local development (note: .env is git-ignored)
#
# For production deployment on Netlify:
# Add this environment variable in: Netlify Dashboard -> Site Configuration -> Environment Variables

# Google Gemini API Key for YUGMA Multi-Agent Heritage AI Companion
# Generate a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

